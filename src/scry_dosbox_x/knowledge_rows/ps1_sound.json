     ]
    }
   ],
   "rows": [
    {
     "n": "0",
     "on": "is",
     "of": "doc",
     "text": "Port 200H carries the output DAC's data and the input ADC's data.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14607",
       "sha": "e5261f52730f17834c20f0a779cf1d8e1758478955cc9e7e92918087586527cd"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14610",
       "sha": "64fb0c391087aea4ba09713cee7ddb409aa43fc4013f7062b81e1db6cf150de0"
      }
     ]
    },
    {
     "n": "1",
     "on": "read",
     "of": "doc",
     "text": "A read of port 200H returns the ADC data latch and clears the ADC Data Ready bit.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14607-14609",
       "sha": "845a3cdf70c378026210abb3ca78fa17ad70c5d7adaef720769a3dac49cfb005"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write to port 200H puts the byte into the FIFO that feeds the output DAC.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14610",
       "sha": "64fb0c391087aea4ba09713cee7ddb409aa43fc4013f7062b81e1db6cf150de0"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "When the FIFO is empty, the byte reaches the DAC at the next overflow of the FIFO timer.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14611-14612",
       "sha": "c44131c45472fad03859d557151a7a1ffc7b94468a7ed5bdd0335af8743e87d3"
      }
     ]
    },
    {
     "n": "S1",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "1",
     "text": "A read returns the last byte written to port 202H and clears bit 0x10 of the status, not an ADC latch.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "236-239",
       "sha": "e8005d92268313edaf83c10dee4e4609b868fd17e6c5b30ca4839bba18be4151"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "173",
       "sha": "d37ce6aaf2a6469b3ae4125607e789e4f5abedc791b652250c04a2d227f64e51"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "53",
       "sha": "278645daeefe04723f97de3d6bee703aac80875504b5bfba9dffc58419d6fd56"
      }
     ]
    },
    {
     "n": "S3",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "The mixer drains the FIFO sample by sample, stepping it by the rate the divisor sets.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "297-308",
       "sha": "7c4a3c711b9c7cf3435842887e31551620fe300748dd817be5efe0fbe3c35a17"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "183-188",
       "sha": "2141976d8b260e1b713c9ae0f40d35c77028cb4599663040fccf6d76eac4dcbd"
      }
     ]
    }
   ],
