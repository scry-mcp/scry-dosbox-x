  {
   "key": "0x202",
   "name": "control register",
   "regions": [
    {
     "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
     "lines": "14635-14665"
    },
    {
     "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
     "function": "PS1SOUNDWrite",
     "case": [
      "0x0202"
     ]
    },
    {
     "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
     "function": "PS1SOUNDRead",
     "case": [
      "0x0202"
     ]
    },
    {
     "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
     "function": "PS1SOUND_CalcStatus"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The port reads as 00H after a RESET.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14650",
       "sha": "af7d45a56d49292dcdbe73596d0b411ea54faad56d24c397da9ef939de300cd8"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "Bit 4 is read only and reports that ADC data has been latched; a read of port 200H resets it.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14642",
       "sha": "6f86f0d9059f4d6709e773630e1ab57409a7e8d752ea019e14121537c762de49"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14655-14657",
       "sha": "2771ebcec42e769e956e41bf8e9ba8d9bfda48e255dd0631cab5533a9f520845"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Bit 3 reports that the FIFO is full.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14643",
       "sha": "e163f9a7e3f5c2adfd7abfff82af703097c10c13faafa4fdbe99b17bf0dc756c"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14658-14659",
       "sha": "464c35ea4b432fb8bec20534ba99b38eb1b7c11951dd0359544c5d6f98388b7c"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "Bit 2 reports that the FIFO is empty.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14644",
       "sha": "bb8f2d89af1147594dd22e935e1ea3380107dd3102f3bacd517fb51395a35399"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14660",
       "sha": "90589187b4d983af0cfdf49e8449d1a81a2b39a7e362cd93217d5462a5e16032"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "A write to bit 2 enables or disables the modem's audio.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14644-14645",
       "sha": "9372e7be79e581283362b36d22545604baf0bec268be3394b5ad41024ac5bfbd"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14660-14661",
       "sha": "80b5965d51500a4dd2b87bd07b54bf777aa75a8adc8c1d3d1d5445dae9a5ddc9"
      }
     ]
    },
    {
     "n": "6",
     "on": "read",
     "of": "doc",
     "text": "Bit 1 reports the almost-empty interrupt.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14646",
       "sha": "4b2916ed10474365f5908774bb7e81c47236e5ed9c3f83e8f941d2f29db482c1"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "doc",
     "text": "Writing 0 then 1 to bit 1 clears the almost-empty interrupt flag.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14646-14647",
       "sha": "eda83178d2eb096e48f94a954e1cb219a400de2ef32e9a0afa30b11675b062ad"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14662-14663",
       "sha": "e2f8dc29bf1c1ea5b7cd1d6fcbc2f62c5fee542368da3f8ea9d1c511a28a2f28"
      }
     ]
    },
    {
     "n": "8",
     "on": "write",
     "of": "doc",
     "text": "A write to bit 5 enables the joystick interrupt.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14640-14641",
       "sha": "bdabe5b72b04118b5e341487f910260e72208c7b63a4419f46ad0cd4b97f054f"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14654",
       "sha": "4d4fe838cb8c7100bbd614327b017b294d0d30f33a9fa4a8fbb899b9d5ac7462"
      }
     ]
    },
    {
     "n": "9",
     "on": "read",
     "of": "doc",
     "text": "Bit 5 reports the joystick interrupt.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14640",
       "sha": "7e6b35d46ea95ec1225e52dcb473750c550585f7fd0c6e39e8e6aa4a58f9b411"
      }
     ]
    },
    {
     "n": "10",
     "on": "write",
     "of": "doc",
     "text": "Bit 6 selects manual joystick mode at 0 and auto mode at 1.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14638-14639",
       "sha": "4da62b31193e5903989e77f793ca6452aef13fccb78641756472407ffd26baff"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14652",
       "sha": "f23e6aba554ecc4cbcdc7a38449d7cc4eaeeef02fe339e355fbd4ce8f00f2d11"
      }
     ]
    },
    {
     "n": "11",
     "on": "read",
     "of": "doc",
     "text": "Bit 6 reads back the RINO signal.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14652-14653",
       "sha": "b2605d05e0df3a565c906731bccd1241488b8ed2b94bb83aea11a241b1a44f20"
      }
     ]
    },
    {
     "n": "12",
     "on": "write",
     "of": "doc",
     "text": "Bit 0 set to 1 enables an interrupt from any of the three internal sources.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14648-14649",
       "sha": "ff7865ea3c4321e7fd0cfbd500ace51e59f7ef351358ff2517b1c79085af94d1"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14664-14665",
       "sha": "466e5a0bb5e9d8ccbfc87a18f73c10af429e66710ed187c2a815826b953cf241"
      }
     ]
    },
    {
     "n": "13",
     "on": "is",
     "of": "doc",
     "text": "The notes print bits 7, RINO, RIN1 and ROUT as reserved, though the table gives bits 7 and 6 to RIN1 and RINO.",
     "quotes": [
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14651",
       "sha": "936673eb51c64c9ae446d226bdefd26ca58acc3f7fcfe6102fb1844429531b20"
      },
      {
       "ref": "datasheet:IBM-PS1-Technical-Reference-57F1970.raw.txt",
       "lines": "14637-14638",
       "sha": "704c0aa980aba6592f57ba12edd9a28a8ba9852d140f4e16dfe7d77de90bdd62"
      }
     ]
    },
    {
     "n": "S2",
     "on": "bit 4",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "A read returns the status the calculation derives from the pending byte count.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "240-249",
       "sha": "48992e20cc9c5fda8b644ebde4cb5bb8d953858c7f92e0b83ec2974712e29c15"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "94",
       "sha": "33fec6b2c995e4109430dee5ea862e149b924618a840697a78581392434b2966"
      }
     ]
    },
    {
     "n": "S5",
     "on": "bit 2",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "5",
     "text": "The write stores the byte and acts only on bits 0-1; bit 2 enables no modem audio.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "171-181",
       "sha": "75f19030c4afd5928d483fb4627db825a7f98032da98e6ee0004b9115d506a6d"
      }
     ]
    },
    {
     "n": "S6",
     "on": "bit 1",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "6",
     "text": "Bit 0x02 reports fewer than 128 bytes pending while command bits 0-1 are 11, not an almost-empty interrupt.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "98-100",
       "sha": "7462f355be41311552746e325228f3b615f10592a811f563eca2af463b5c40ac"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "56",
       "sha": "e9fc3624090cbbdba10ff0f2dbdd3a58b87ff3a653391a3608c356232ee35315"
      }
     ]
    },
    {
     "n": "S7",
     "on": "bit 1",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "7",
     "text": "The write stores the byte and arms the FIFO interrupt from bits 0-1; no flag is cleared.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "171-181",
       "sha": "75f19030c4afd5928d483fb4627db825a7f98032da98e6ee0004b9115d506a6d"
      }
     ]
    },
    {
     "n": "S8",
     "on": "bit 5",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "8",
     "text": "The write stores the byte and enables no joystick interrupt.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "171-181",
       "sha": "75f19030c4afd5928d483fb4627db825a7f98032da98e6ee0004b9115d506a6d"
      }
     ]
    },
    {
     "n": "S9",
     "on": "bit 5",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "9",
     "text": "The read returns the FIFO status only, with no joystick interrupt bit.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "93-113",
       "sha": "7a8701d8b6ddc2fbafb34f207e7da3714ca2363487065f192199542da7b1dbe6"
      }
     ]
    },
    {
     "n": "S10",
     "on": "bit 6",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "10",
     "text": "The write keeps the byte in ps1.Command and arms the FIFO interrupt from bits 0-1; bit 6 selects nothing.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "171-181",
       "sha": "75f19030c4afd5928d483fb4627db825a7f98032da98e6ee0004b9115d506a6d"
      }
     ]
    },
    {
     "n": "S11",
     "on": "bit 6",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "11",
     "text": "The read returns the FIFO status only, with no RINO bit.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "93-113",
       "sha": "7a8701d8b6ddc2fbafb34f207e7da3714ca2363487065f192199542da7b1dbe6"
      }
     ]
    },
    {
     "n": "S12",
     "on": "bit 0",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "12",
     "text": "The write arms the FIFO interrupt when bit 0 or bit 1 is set, so bit 1 also arms it.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "173-174",
       "sha": "aed508e1e271fadfb47640843b2b53bb4ca619823532b37338420d058d91b9c5"
      }
     ]
    },
    {
     "n": "SX",
     "on": "is",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "DOSBox-X rebuilds ps1.Status from the pending count on reset, on a 0x200 write, on a 0x202 read and on each mixer update, and clears bit 0x10 on a 0x200 read.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "126",
       "sha": "b1421b1c084c61c5e0874025afea6df31a7a67575b93552b52cca04e43033244"
      },
      {
