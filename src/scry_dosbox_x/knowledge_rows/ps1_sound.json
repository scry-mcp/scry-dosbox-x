       "sha": "b1421b1c084c61c5e0874025afea6df31a7a67575b93552b52cca04e43033244"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "245",
       "sha": "a8cdfd74dce40529de150030daf692ba6f1787c1054222c963232b5774af9b55"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "238",
       "sha": "8288deb35dcab1ac3bc5c739d07825e06bc47ce3426738d4188a38f21c261e72"
      },
      {
       "ref": "dosbox-x:src/hardware/ps1_sound.cpp",
       "lines": "279",
       "sha": "b1421b1c084c61c5e0874025afea6df31a7a67575b93552b52cca04e43033244"
      }
     ]
