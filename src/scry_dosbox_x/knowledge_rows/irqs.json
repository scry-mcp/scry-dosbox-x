   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "IRQ0 is the system timer's line, interrupt 08h.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.A",
       "lines": "587",
       "sha": "73f98191de3d3115fd4f9182e5ff94958ec899baed028b4097d95063a18594a7"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "Channel 0 of the 8254 system timer generates it 18.2 times per second.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.A",
       "lines": "588",
       "sha": "def2bd1a301071853e11f405e16f9b2c3027df9c21d1e7238ea1141d0a5f93f5"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "It is used to keep the time-of-day clock updated.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.A",
       "lines": "589",
       "sha": "fbc5f0e3f9ce2b622eb3597680d7b3515b63b90fdc0b4acae7035b0f43c8dd11"
      }
     ]
    },
    {
