     "lines": "4442-4443"
    },
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "4453-4455"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "function": "write_p3c8"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "function": "read_p3c8"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "read",
     "of": "doc",
     "text": "The register list gives the palette write address at hex 03C8 as read/write.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2670",
       "sha": "b9921950e75850b36fa16707eeb30e74b103498e854e7f58920537733dc1f44c"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The palette address register holds an 8-bit value that addresses a location in the DAC.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4436-4437",
       "sha": "edcc13644865bdb0ae9bb87a91ac9cdf98ea49b75d4881c108d3ef2467c3604c"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "For palette write operations the address register is at hex 03C8.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4442-4443",
       "sha": "ca4c193b0e540e3a84762c84987dae2a579b4e5838f94e2fcb0cf552ffbafc42"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The write also sets the read index to the value minus one, except on a Paradise PVGA1A card.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "286-287",
       "sha": "c3b0d4a9486594332685448592ef6e33041274c9507233418e09b85aa1de436d"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A DAC lockout makes the write do nothing; otherwise the write clears the HiDAC counter.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "279-282",
       "sha": "246797eeba4b3460fc7a121ac8acf4951b81fe64bdf683d3ca9dc035ada1a509"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "Writing the palette address register during a cycle starts a new cycle and ends the unfinished one.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4453-4455",
       "sha": "6bf43f1b86acd9837f601230d21f34d7c5904bc552d55a056d77a84d1ae4e331"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Hex 03C8 is the palette address register for write operations.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2670",
       "sha": "b9921950e75850b36fa16707eeb30e74b103498e854e7f58920537733dc1f44c"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "The palette address register responds to two addresses.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4438",
       "sha": "0f800aebf99e818eb58fb37a093f4b916042ce51248e41dadd1ed0371628cbc5"
      }
     ]
    },
    {
     "n": "9",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The read also clears the HiDAC counter.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "293",
       "sha": "0e196a4c2a1dd7f81b7a3160114f9e456a3c50aef1039e91332b7f0414146933"
      }
     ]
    }
   ],
