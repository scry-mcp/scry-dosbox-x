 "entries": [
  {
   "key": "0x3C6",
   "name": "PEL mask",
   "aliases": [
    "03C6"
   ],
   "regions": [
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "2673"
    },
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "4487-4489"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "function": "write_p3c6"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "function": "read_p3c6"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "read",
     "of": "doc",
     "text": "The register list gives the Pel Mask at hex 03C6 as readable; the capture shows the mark as RIW.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2673",
       "sha": "29aab157276f1c5d8ffbbf0e7acdb038ce11dc81d5f9bf719aa8dadcf9661ab7"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The document tells the programmer not to write the Pel Mask register, since palette information can change.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4487-4488",
       "sha": "8b58a44f6e548047744efafa45a51056ca923954a57b61c37312dc97e3e50a7a"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "A mode set initializes the Pel Mask register to hex FF.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4489",
       "sha": "1c9726f3be43c5e1c33c3040f142c078f31e39d2e6ce190b007da213285c6044"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write stores the byte into vga.dac.pel_mask, or into reg02 when a VGA machine's 3C6 HiDAC counter is above 3; a DAC lockout stores nothing.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "221-232",
       "sha": "e50a4abe5588cdc23ec96fca46111df3a28de33a8605ac333ae8cec833a2d7fc"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "246-247",
       "sha": "9a3f867b4df3a5807fb5de713f459242e2bd14413dd4cc864db70f8eb69e4833"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "A changed mask schedules a palette update, rendering up to the change when rendering is on demand.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "230-238",
       "sha": "bcfca5dbeb8cd25f15bee87fa5d21c3789bb25f9312034718ed48ba78a8beb7d"
      }
     ]
    },
    {
     "n": "6",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "When the Sierra RAMDAC setting is on, the read also increments the HiDAC counter.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "246-247",
       "sha": "9a3f867b4df3a5807fb5de713f459242e2bd14413dd4cc864db70f8eb69e4833"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "lines": "445",
     "as": "unseen",
     "reason": "the reset store in VGA_SetupDAC, outside the entry's regions"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "lines": "243-250",
     "as": "agrees",
     "row": "1"
    }
   ]
  },
  {
   "key": "0x3C7",
   "name": "PEL read address",
   "aliases": [
    "03C7"
   ],
   "regions": [
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "2671"
    },
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "4447-4448"
    },
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "4458-4464"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "function": "write_p3c7"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_dac.cpp",
     "function": "read_p3c7"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Hex 03C7 is the palette address register for read operations.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2671",
       "sha": "56a57063c91d41a35c02699aaccc653a45f0e0b3596f0a8cb0198a9e64f84312"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "For palette read operations the palette address register is at hex 03C7.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4447-4448",
       "sha": "585314d7887a6210958166b691f7a8d8b4111415036ffc5b72d543f202339b6b"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "The DAC State register is read only at hex 03C7; bits 1 and 0 return the last operation, both 1 after a read and both 0 after a write.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4458-4461",
       "sha": "a5bfd80e2bcdceaf816f28c9a7fef745b74b2200885f33d60a70549078484120"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "Reading the DAC State register at 03C7 does not interfere with the read or write cycles.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "4462-4464",
       "sha": "ff8b6628f38ca2a742928d3d969fc84b65e972e4764e2e4faa9b4ac81fae4bf7"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The write also sets the write index to the index plus one.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "264",
       "sha": "a2f308f63414c12f4fc1c0241a2858f1f308574c211bbf0017f2610c52cdda20"
      }
     ]
    },
    {
     "n": "6",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The read also clears the HiDAC counter.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "270",
       "sha": "0e196a4c2a1dd7f81b7a3160114f9e456a3c50aef1039e91332b7f0414146933"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A DAC lockout makes the write do nothing; otherwise the write clears the HiDAC counter.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_dac.cpp",
       "lines": "257-260",
       "sha": "246797eeba4b3460fc7a121ac8acf4951b81fe64bdf683d3ca9dc035ada1a509"
      }
     ]
    }
   ],
   "closed": [
