    {
      "key": "0x3C1",
      "name": "attribute read port",
      "aliases": [
        "attribute read address"
      ],
      "regions": [
        {
          "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
          "lines": "3918-3921"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "lines": "449-450"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "lines": "451-453"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "function": "read_p3c1",
          "case": [
            "0x00"
          ]
        }
      ],
      "rows": [
        {
          "n": "1",
          "on": "is",
          "of": "doc",
          "text": "Each attribute controller register has two addresses: hex 03C0 is the write address and hex 03C1 the read address.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3918-3921",
              "sha": "9b8ae639f51f0e4848acdae10b66e9e587b235fdd1cb137c8de6a705275dfd19"
            }
          ]
        },
        {
          "n": "2",
          "on": "read",
          "of": "doc",
          "text": "A read of 03C1 returns the data register selected by the index written to the Address register.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3918-3921",
              "sha": "9b8ae639f51f0e4848acdae10b66e9e587b235fdd1cb137c8de6a705275dfd19"
            }
          ]
        },
        {
          "n": "101",
          "on": "is",
          "of": "dosbox-x",
          "vs": "differs",
          "text": "On the EGA machine DOSBox-X also registers the write handler at 03C1, an alias the document gives only as the read address.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "449-450",
              "sha": "c32e53e3f77d16c6d914cbf18906a2a7cd7d96ffd7e6c2060fff07ba828fda30"
            }
          ],
          "row": "1"
        },
        {
          "n": "102",
          "on": "read",
          "of": "dosbox-x",
          "vs": "differs",
          "text": "On a VGA machine a read of 03C1 returns the selected data register; on an EGA no read handler is registered and the unhandled read returns hex FF.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "451-453",
              "sha": "18b5f00dc8c64dccbc5efd49239434a43db868df4e641af3ea2a90fd54f2dae0"
            },
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "426",
              "sha": "afc21889a51d81a77826c6d67de22f069cec7e32150eea4a5ce460bb5168e284"
            },
            {
              "ref": "dosbox-x:src/hardware/iohandler.cpp",
              "lines": "58-59",
              "sha": "ddb05d69daf8886b0b482c4a4f3989e617d2b25c8d7fcdab043a6d4a5c58bfe9"
            },
            {
              "ref": "dosbox-x:src/hardware/iohandler.cpp",
              "lines": "183-184",
              "sha": "bc5e2cc6b877788904592bb44f67844659b5419f62377dc0fc0e7d3c64817bb2"
            },
            {
              "ref": "dosbox-x:src/hardware/iohandler.cpp",
              "lines": "239",
              "sha": "9d886c56b4b60cce3a6228c7f5cfc964baed6c518866cf4fcb67bf61d45865a7"
            }
          ],
          "row": "2"
        }
      ],
