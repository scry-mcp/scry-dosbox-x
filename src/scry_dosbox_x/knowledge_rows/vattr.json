    {
      "key": "0x00..0x0F",
      "name": "palette registers",
      "aliases": [
        "internal palette",
        "attribute palette"
      ],
      "regions": [
        {
          "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
          "lines": "3975-3977"
        },
        {
          "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
          "lines": "3983-3996"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "function": "write_p3c0",
          "case": [
            "0x00"
          ]
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "function": "read_p3c1",
          "case": [
            "0x00"
          ]
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "lines": "112-115"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "lines": "153-154"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "lines": "214-215"
        },
        {
          "ref": "dosbox-x:src/hardware/vga_attr.cpp",
          "lines": "453"
        }
      ],
      "rows": [
        {
          "n": "1",
          "on": "is",
          "of": "doc",
          "text": "The internal palette registers are at indexes hex 00 through 0F, written at 03C0 and read at 03C1.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3975-3977",
              "sha": "b104175cadca7624dcaab6e7ccf596a53e498d3668e55530bf5f9b62c58075d6"
            }
          ]
        },
        {
          "n": "2",
          "on": "write",
          "of": "doc",
          "text": "Each is a 6-bit register, bits 5-0, mapping the text attribute or graphic color input value to a display color.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3983-3987",
              "sha": "47eaa7053a573a2c3ff806f2b11255093d6a8338c83711d4b85a855432ca7be6"
            }
          ]
        },
        {
          "n": "3",
          "on": "write",
          "of": "doc",
          "text": "The palette values are sent off-chip to the video DAC, which uses them as addresses into its registers.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3990-3993",
              "sha": "089b03ec128b4109d97e340217c87a86e476b2129bdf6b707037073ea2da0f5e"
            }
          ]
        },
        {
          "n": "4",
          "on": "is",
          "of": "doc",
          "text": "The document advises modifying the internal palette registers only during the vertical retrace interval.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3987-3989",
              "sha": "ed603580898ccf9753bbe09a36f63c6e4693a04434d02213c6b850f383597cdb"
            }
          ]
        },
        {
          "n": "5",
          "on": "write",
          "of": "doc",
          "text": "These registers can be accessed only while bit 5 of the Address register is 0; with it 1, writes are don't care.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3994-3996",
              "sha": "223ecdc5cc69184bbb20aa487f4a9125dccff4333cec6e79b109445e19423293"
            }
          ]
        },
        {
          "n": "6",
          "on": "read",
          "of": "doc",
          "text": "The registers are read at 03C1.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3975-3977",
              "sha": "b104175cadca7624dcaab6e7ccf596a53e498d3668e55530bf5f9b62c58075d6"
            }
          ]
        },
        {
          "n": "7",
          "on": "read",
          "of": "doc",
          "text": "With bit 5 of the Address register at 1, a read of a palette register returns undefined data.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3995-3996",
              "sha": "0a2283b5a1cb8949c5c5902481c0504beb15a42c9611695e34b5fa89015b300e"
            }
          ]
        },
        {
          "n": "101",
          "on": "write",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "When the enabled-plane mask is not hex 0F, a palette write re-sends the other fifteen entries to the DAC.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "256-264",
              "sha": "60235d510eb12b705f95651aaf52d7813441cc5348061fe417f0f7114bbf735d"
            }
          ]
        },
        {
          "n": "102",
          "on": "write",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "On a CGA-4/DCGA machine a nonzero value written to palette index 0 is stored as 0.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
