              "sha": "bac6c211296529ce80d4c43012b94981543ddfd6ebd61d1a7de289c37cbad62d"
            }
          ]
        },
        {
          "n": "2",
          "on": "bits 3-0",
          "of": "doc",
          "text": "The field is stored; a bit set in the Enable Color Plane field, bits 3-0, enables the corresponding display-memory color plane.",
