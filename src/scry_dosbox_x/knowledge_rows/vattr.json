      "rows": [
        {
          "n": "1",
          "on": "is",
          "of": "doc",
          "text": "The Address register is a read/write register at address hex 03C0.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3939-3940",
              "sha": "56586cc8b6f7a6f47472e439071f0d67f0404541a4c32e7dbd53805aa6bbd25a"
            }
          ]
        },
        {
          "n": "2",
          "on": "order",
          "of": "doc",
          "text": "The attribute controller has no input bit to select address or data: an internal address flip-flop does it.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3948-3950",
              "sha": "ebdb2824367139e8d6bb1618d41195737c93bf004dc61144248480bfe5085155"
            }
          ]
        },
        {
          "n": "3",
          "on": "order",
          "of": "doc",
          "text": "Reading Input Status Register 1 clears the flip-flop and selects the Address register.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3950-3951",
              "sha": "cbd5985eb4cf3fc61089acbb3eba62a9649ee8688b1b2bf011787c70eab945cf"
            }
          ]
        },
        {
          "n": "4",
          "on": "write",
          "of": "doc",
          "text": "After the Address register holds an index, the next write to 03C0 loads the data register.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3952-3953",
              "sha": "e9c30866689bf7b06283cf03de51d3739afb5a52adefdf92315e8e745958da63"
            }
          ]
        },
        {
          "n": "5",
          "on": "order",
          "of": "doc",
          "text": "The flip-flop toggles on each write to 03C0 and does not toggle for a read of 03C0.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3953-3956",
              "sha": "6a27b7e317ef39db273b22b9a21bd23e527e196a3da6a8a4b381963ac3b0870a"
            }
          ]
        },
        {
          "n": "6",
          "on": "bit 5",
          "of": "doc",
          "text": "IPAS, bit 5, is kept: 0 loads color values to the registers of the internal palette, 1 is normal operation of the attribute controller.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3963-3966",
              "sha": "9c2f4a63cfe3c23f08448d46e697a019b474a82a27b804c73f9292729fbea9fe"
            }
          ]
        },
        {
          "n": "7",
          "on": "is",
          "of": "doc",
          "text": "The document advises against accessing the internal palette while IPAS is 1: a Type 1 subsystem disables it, a Type 2 does not and the value cannot be ensured.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3968-3972",
              "sha": "9e376925aa64838c77ba4ca98657388cbfb7f9df5f7a5bd8759e29d5ac17366b"
            }
          ]
        },
        {
          "n": "8",
          "on": "bits 4-0",
          "of": "doc",
          "text": "The Index field, bits 4-0, is stored as the index to the data registers in the attribute controller.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3973-3974",
              "sha": "ccdd5a660d31863f6c1974392a7d2a7d72fbaf86040928f8e9e28854a592c9bc"
            }
          ]
        },
        {
          "n": "9",
          "on": "read",
          "of": "doc",
          "text": "The Address register is readable: the document calls it a read/write register.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3939-3940",
              "sha": "56586cc8b6f7a6f47472e439071f0d67f0404541a4c32e7dbd53805aa6bbd25a"
            }
          ]
        },
        {
          "n": "101",
          "on": "write",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "A write to 03C0 returns untouched while the guest has DOSBox-X's VGA register lockout flag set.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "195-196",
              "sha": "2ac51aaef5d0cbe7a01ab858b54ef2de34df23538626a3a93ba02a1c573d48ab"
            }
          ]
        },
        {
          "n": "102",
          "on": "read",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "A read of 03C0 returns the index in bits 4-0 and sets bit 5 when IPAS was written 1; bits 7-6 read as 0.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "185-187",
              "sha": "0107dcf021e2ea5f736d71159195e959efbb05f0da4f0d3ef50f1edf85a6b1a9"
            },
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "214-215",
              "sha": "a826f91d4014426404d49bd6bef1b26e499968f0944f34deb546ae39c84a3a6a"
            }
          ]
        },
        {
          "n": "103",
          "on": "write",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "With render-on-demand on, a write to 03C0 renders the screen up to the current point while the screen is enabled, before latching and after.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "211-216",
              "sha": "b3c5c8e525efb6a6a7ab4ec51a6580d32a66ecf91e0ab679e8347f7997c4a454"
            }
          ]
        },
        {
          "n": "104",
          "on": "read",
          "of": "dosbox-x",
          "vs": "differs",
          "text": "On an EGA machine no read handler is installed at 03C0; reads are registered for the VGA only.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "451-454",
              "sha": "b7992ebc4f46a43ac781d0dbbab0fd7d6a40af30a8b3af5ef03b6dd97d29a903"
            }
          ],
          "row": "1"
        },
        {
          "n": "105",
          "on": "read",
          "of": "dosbox-x",
          "vs": "differs",
          "text": "A read of 3DA clears the flip-flop unless the guest has set DOSBox-X's 3DA lockout flag, in which case it returns 0.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_misc.cpp",
              "lines": "60-61",
              "sha": "bda9fcdea39a29fea26a9cb7149b902cbb797c2ba94e0046cd8125baf9920fb6"
            },
            {
              "ref": "dosbox-x:src/hardware/vga_misc.cpp",
              "lines": "68",
              "sha": "30b84b4f73eb627d0bdb7f253806e12d33567657b929313b56df787f6d9f93c5"
            }
          ],
          "row": "3"
        },
        {
          "n": "10",
          "on": "order",
          "of": "doc",
          "text": "A read of 03C1 does not toggle the flip-flop.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "3954-3956",
              "sha": "abe5950442e98170ef04aadd19625af33a0e5a08b49402a52cfa72933b66da1f"
            }
          ]
        }
      ],
      "closed": [
