    {
      "key": "0x3C0",
      "name": "address register",
      "aliases": [
        "attribute address register",
        "index port"
      ],
      "regions": [
        {
          "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
          "lines": "3939-3940"
        },
        {
          "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
