      "rows": [
        {
          "n": "1",
          "on": "is",
          "of": "doc",
          "text": "The Color Select register is a read/write register at index hex 14, written at 03C0 and read at 03C1.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "4111-4113",
              "sha": "57da8ca565a81986be0fcb75b30d783f79cda5078e7c943cd5997356f40a1142"
            }
          ]
        },
        {
          "n": "2",
          "on": "bits 3-2",
          "of": "doc",
          "text": "Bits 3 and 2 are stored; outside mode hex 13 they are the DAC value's top two bits, and in mode hex 13 the attribute itself is the value.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "4126-4133",
              "sha": "92476939e468fe6cfd6a8a019515739cbe0e01c4ff3c1c3f23cc403b68685c8d"
            }
          ]
        },
        {
          "n": "3",
          "on": "bits 1-0",
          "of": "doc",
          "text": "Bits 1 and 0 are stored; they can replace P4 and P5 of the Internal Palette registers to form the 8-bit DAC value.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "4134-4139",
              "sha": "943930ea97524b602665a389ae8aa9fb5634d0e875e38e162a5dfc069158d036"
            }
          ]
        },
        {
          "n": "4",
          "on": "read",
          "of": "doc",
          "text": "The register is read at port hex 03C1.",
          "quotes": [
            {
              "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
              "lines": "4112-4113",
              "sha": "61ad05d335f5e0bceaefe343ef11a108bbcbf6c433e40b1f3d801e0a77e4521d"
            }
          ]
        },
        {
          "n": "101",
          "on": "write",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "While emulating an EGA, a write to index hex 14 stores 0 instead of the written value.",
          "quotes": [
            {
              "ref": "dosbox-x:src/hardware/vga_attr.cpp",
              "lines": "389-391",
              "sha": "640f9a5ea6bd5a37cf6c19007238711c3b75be7af398173b39e6799959adeedc"
            }
          ]
        },
        {
          "n": "102",
          "on": "write",
          "of": "dosbox-x",
          "vs": "extra",
          "text": "A change of the register makes DOSBox-X re-send all sixteen palette entries to the DAC.",
          "quotes": [
