       "sha": "ee717d9f777ef005f5bb6a3d4d04a88931b72ef4c914e3203f127cd305fa6e6d"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The data sheet calls the A0 = 0 byte the control register's data and the A0 = 1 byte the address buffer.",
     "quotes": [
      {
       "ref": "datasheet:SAA1099.raw.txt",
       "lines": "114-115",
       "sha": "e84ea6c6d600c4c3ae465fdb62acedb9ec8e4beaab69e0659399dc018508e4f9"
