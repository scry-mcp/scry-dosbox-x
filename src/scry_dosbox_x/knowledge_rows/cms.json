       "sha": "4b67a41c3bfc43bc1fa10cb9a653653de5f54a3bac5c8b93471b179730e4eca2"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The command and control information is multiplexed to simplify the microprocessor interface.",
