    }
   ],
   "regions": [
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "lines": "326"
    },
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "lines": "168-226"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "On such a machine DOSBox-X installs TandyDACWrite for four ports at 0x01E4.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "302-306",
       "sha": "341308062e6ac0b672bbb3d61814f0c9c917d4bdd474580f8f3cb527de7d3a8a"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "314-324",
       "sha": "e281159626b013321d2c1fba1937fdde4ca415a8c7beb316c41343b07ae13252"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "325-326",
       "sha": "9e9deda8ba1d579474401bd4ef691a86ef7f9da8a393821c7516a77b7a86852a"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write to 0x01E4-0x01E7 changes nothing: the handler tests the port number against 0xC4-0xC7 and has no other case.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "168-179",
       "sha": "496bd3015d5d1ca19018ccd52e0554453187fdbc763d4a6dfabe931814c08bfd"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "180-191",
       "sha": "4271d93f55e97f1b8e35a9425a7290daf5ca34a3abdee3ab9bb78974e99762b4"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "192-203",
       "sha": "73dab201bba7cded4223c6fd870921590d24315de4a9d11c85f238e607f2eed1"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "204-215",
       "sha": "554b3d0d0945d00b9420c908af3f2a342eef115fc07ebc444f50bf7ba06992e2"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "216-226",
       "sha": "23ccc24926b8e48f857fde081949e1acdd6036620223a064baab0d0ad61635c9"
      }
     ]
    },
    {
     "n": "P",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
