       "sha": "1c3a625fbac777869849290435d7b3bc5702d4f8a55f038cf7b5db0647007176"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Bits 5-7 hold the amplitude in seven levels of about 3 dB, where 111 is the maximum and 000 no output.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1996-2006",
       "sha": "337b352dd7fd3dc4ef4479e7cfa1ece9b0d60cf6f7f1fff45ea12cf6607c7b3e"
