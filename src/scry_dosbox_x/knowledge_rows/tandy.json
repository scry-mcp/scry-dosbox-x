  {
   "key": "0xC4",
   "name": "Tandy DAC mode register",
   "regions": [
    {
     "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
     "lines": "6876-6933"
    },
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "lines": "346-347"
    },
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "function": "TandyDACWrite"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "00C4h is the C4 write register that selects the DAC function.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6876-6877",
       "sha": "fd4ae245c9b70b77b6142561cbfb35d80360eb7b2084bdc87cd2779fe36d9b84"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6899-6900",
       "sha": "ad3bb52936beab6be9cd022ec1ce27407fbc8abd140008dae343e683e4740118"
      }
     ]
    },
    {
     "n": "2",
     "on": "bits 0-1",
     "of": "doc",
     "text": "Bits 0-1 select one of four DAC functions: joystick, sound channel, successive approximation, direct write to the DAC.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6878-6882",
       "sha": "7c9f27abc4899b4d90ad6d5cd2cb42fc5c64b3604d4ad0d5fbf31e348d61c93f"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6899-6904",
       "sha": "d5632555a1446f27e21eeba63fdd4aceef9f464a282297b938298284100b14d1"
      }
     ]
    },
    {
     "n": "3",
     "on": "bit 2",
     "of": "doc",
     "text": "Bit 2 enables DMA for successive approximation and direct access, SA and DA.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6883-6885",
       "sha": "6d46b101f5b9fc0c807a88dfa74eae79ca417810dcd59a24e25943b90674cd9e"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6905-6907",
       "sha": "26e75873622487513e94663069da70adf70985ae19bf185a75abd3b2780b4fe4"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6899",
       "sha": "c6bc7b798ae8cfecf3d78c356649dbb3b2690f7d173a9f1de0238aab2a8f394b"
      }
     ]
    },
    {
     "n": "4",
     "on": "bit 3",
     "of": "doc",
     "text": "Bit 3 clears the DMA interrupt while it is low, and the interrupt is allowed while it is high.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6886-6888",
       "sha": "f381644cf97ca9a221c08e8d631d03106efb783b7864ef1295c82649bdae2dee"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6908-6912",
       "sha": "5996f8d8a8b51c1721cba4f5422890b964d9d052bf0545892cb709e074c956c8"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6899",
       "sha": "c6bc7b798ae8cfecf3d78c356649dbb3b2690f7d173a9f1de0238aab2a8f394b"
      }
     ]
    },
    {
     "n": "5",
     "on": "bit 4",
     "of": "doc",
     "text": "Bit 4 enables the DMA interrupt: the DMA EOP interrupt disabled or enabled.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6889-6891",
       "sha": "084c956fed448858b691dc0ed2f7d257bb2150db8b42c3c6fa16cc18c4f94656"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6912-6914",
       "sha": "d65f02e9ec12c7badffbdb307601734216b9a54e49cd7240832f5272797c7995"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6899",
       "sha": "c6bc7b798ae8cfecf3d78c356649dbb3b2690f7d173a9f1de0238aab2a8f394b"
      }
     ]
    },
    {
     "n": "6",
     "on": "bit 5",
     "of": "doc",
     "text": "Bit 5 enables divider synchronization, and then a write to C6 or C7 reloads all dividers.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6892-6894",
       "sha": "9d3d97e9555a8bb36881cf03146db5187b3c3dded9cc115bcdf8174ed88b1b5b"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6915-6918",
       "sha": "1fc57e18237b9d91d05bc66c0bd9491df41094bdb05e102dfa99be8c1b8fdf00"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6899",
       "sha": "c6bc7b798ae8cfecf3d78c356649dbb3b2690f7d173a9f1de0238aab2a8f394b"
      }
     ]
    },
    {
     "n": "7",
     "on": "bit 6",
     "of": "doc",
     "text": "Bit 6 enables an extra bit of division in the sound chip.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6895-6897",
       "sha": "99937b3be0d7b2da863ec018c73751894a66a69f76c871c85438075b1dad2336"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6919-6922",
       "sha": "d2f09acaf3195438b30a16958766ce200e6e61feccee34cc304ad05b740db24a"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6876",
       "sha": "0fcb16bfd92f3ed0ef2273a2ab96753a24e64b7e884950d7d2c5ae2bc577894c"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "Bit 7 is reserved.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6898",
       "sha": "205a2d20f0fa3835b3ea1fe417a3f0315bc706e51484e1b8dc55111b0a7937c2"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6923",
       "sha": "c0d03c1239e01842d73cf046314bdc7de6e5d3280afc9776262f78be40a95bab"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6876",
       "sha": "0fcb16bfd92f3ed0ef2273a2ab96753a24e64b7e884950d7d2c5ae2bc577894c"
      }
     ]
    },
    {
     "n": "9",
     "on": "read",
     "of": "doc",
     "text": "A read gives every bit back except bit 3, and bit 7 says whether an approximation is done; bit 3 says a DMA interrupt occurred.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6924-6933",
       "sha": "ac705e2fc85a276bdc116d3546104cbea035858c50696f90fca6929cce43326f"
      }
     ]
    },
    {
     "n": "D2",
     "on": "bits 0-1",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "DOSBox-X switches on the two bits with joystick, recording and playback named, the second value doing nothing, and acts on playback alone.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "128-139",
       "sha": "e9b765e53fed6284d155821352b83f84446db9cec8b23c1f40f557f708e20404"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "140-149",
       "sha": "aea4169e3c3e8580d38e58fa3e93923fb0b1b7a1e2e19b597824007aa67d828b"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "150-158",
       "sha": "26d9f3ba0c2d935ea08804e6de46415fa4e779a23edd1b42fdb26062086b7f41"
      }
     ]
    },
    {
     "n": "D3",
     "on": "bit 2",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "DMA starts only when bit 2 and bit 3 are both set, so bit 2 alone enables nothing.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "176-180",
       "sha": "d8f8203ca9193f21682d8c40f61bd801c24504d8b01894e86889fed3a674591f"
      }
     ]
    },
    {
     "n": "D4",
     "on": "bit 3",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "4",
     "text": "Bit 3 arms the DMA transfer together with bit 2 instead of clearing an interrupt, and no transfer sets the interrupt flag.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "176-180",
       "sha": "d8f8203ca9193f21682d8c40f61bd801c24504d8b01894e86889fed3a674591f"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "121-126",
       "sha": "8ab847e8f7f9e5c2c9a08411908d060721f09b0740aa2d85ebbb606385a2d4e1"
      }
     ]
    },
    {
     "n": "D5",
     "on": "bit 4",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "5",
     "text": "The case stores the byte and never reads bit 4, and an interrupt is raised at terminal count whether the bit is set or not.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "170-181",
       "sha": "49f5b544010512c0b755252af14e2cb8be3744726b34118a8a769dbb1db729de"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "122-126",
       "sha": "8ab847e8f7f9e5c2c9a08411908d060721f09b0740aa2d85ebbb606385a2d4e1"
      }
     ]
    },
    {
     "n": "D6",
     "on": "bit 5",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "6",
     "text": "The handler never reads bit 5, and a write to C6 or C7 reloads no divider.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "168-226",
       "sha": "266b3af12c519a979739d4987b3abf7a40dcaa3ec10b96609ee1bddbf57970c8"
      }
     ]
    },
    {
     "n": "D7",
     "on": "bit 6",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "7",
     "text": "The case never reads bit 6, so no extra division is enabled.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "170-181",
       "sha": "49f5b544010512c0b755252af14e2cb8be3744726b34118a8a769dbb1db729de"
      }
     ]
    },
    {
     "n": "D9",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "9",
     "text": "A read of 0x00C4 returns the mode with bits 3 and 7 clear, and bit 3 never reads set because nothing records the interrupt.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "228-231",
       "sha": "809433d1a2bf10d984f2f07353cac44d36eb7426c08c8e00b41601f519a29c8f"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "366",
       "sha": "99a91de048a133a6dca4966811c17c29b8cc7a1008d6ca1036041936b7fb2944"
      }
     ]
    },
    {
     "n": "P",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "DOSBox-X reaches the register through TandyDACWrite and TandyDACRead, installed for four ports at 0x00C4.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "346-347",
       "sha": "f0c0fa71ad3a56ebb9381413b7fdd05763acf0c29061f89bf0e9b3b3c3d499cc"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "lines": "168-226",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0xC5",
   "name": "Tandy DAC control",
   "regions": [
    {
     "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
     "lines": "1953-1979"
    },
    {
     "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
     "lines": "6988-6990"
    },
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "lines": "346-347"
    },
    {
     "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
     "function": "TandyDACWrite"
    },
    {
     "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
     "lines": "6951-6953"
    },
    {
     "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
     "lines": "6978-6979"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A write of 00C5h sets the sound control register.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1954",
       "sha": "af3b0590ede44ae3f144c04818dd06d8b8df2b739aee7256f0a97c841990e859"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6978-6979",
       "sha": "ece7f6e626ee63f3536f4224c72947d6c5147c679d035b156fb95dd864a1274a"
      }
     ]
    },
    {
     "n": "2",
     "on": "bits 0-2",
     "of": "doc",
     "text": "Bits 0-2 select the duty cycle, from 6.25% in steps of 6.25% up to 50%.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1955-1964",
       "sha": "b482dbdaff02e377e8e46c2c5bf5481f7577d244eac21fa4833961c7da1bca19"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Bits 3-5 are reserved.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1965-1967",
       "sha": "9e96d88f4b6130f47039629d5dc59e6aa789399a9396f3624129e45c8942623f"
      }
     ]
    },
    {
     "n": "4",
     "on": "bits 6-7",
     "of": "doc",
     "text": "Bits 6-7 select the waveshape: pulse, ramp or triangle, and the fourth value is reserved.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1968-1973",
       "sha": "312e1c8720c8b2ac1dee67ebc6958ce67076c67813bb0ced8be8ae476539d07e"
      }
     ]
    },
    {
     "n": "5",
     "on": "read",
     "of": "doc",
     "text": "A read of 00C5h gives the DAC directly when bits 0-1 of 00C4h are 1x, and the control register when they are 01.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1974-1979",
       "sha": "083626e55cd4afbeefb5c840f153e5e0894415a809730744cb666c6f725d3802"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6951-6953",
       "sha": "ecf0eda39e373c7c802ef3557a1a8ba15053de6e5afe012ef3241d401828ca8a"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6978-6979",
       "sha": "ece7f6e626ee63f3536f4224c72947d6c5147c679d035b156fb95dd864a1274a"
      }
     ]
    },
    {
     "n": "D2",
     "on": "bits 0-2",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "2",
     "text": "The case stores the control byte in mode 1 and does nothing else with it, so no duty cycle is set.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "183-197",
       "sha": "1a87f0f5e5945fc4cd885bfb33d6c9f3261a116935461f9990607155d43c5968"
      }
     ]
    },
    {
     "n": "D4",
     "on": "bits 6-7",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "4",
     "text": "The case never reads the waveshape bits, so a pulse, ramp or triangle is never generated.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "183-197",
       "sha": "1a87f0f5e5945fc4cd885bfb33d6c9f3261a116935461f9990607155d43c5968"
      }
     ]
    },
    {
     "n": "D5",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "5",
     "text": "A read of 0x00C5 matches no case of the DAC read handler, which logs it and returns 0xFF.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "228-239",
       "sha": "c36516d63ad874b468cfa1b36b83bf6d51b84fa249e8384a8393c2b607d098e5"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "In the ramp waveshape the five MSBs of the DAC count up; in the triangle the four count up and back down.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "6988-6990",
       "sha": "26ebba086442b7037885f476abc028e910c0e4337071f2c3f1498a87a8c09f71"
      }
     ]
    },
    {
     "n": "D6",
     "on": "write",
     "of": "dosbox-x",
     "vs": "absent",
     "row": "6",
     "text": "The case never reads the waveshape bits, so neither the ramp nor the triangle is generated.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "183-197",
       "sha": "1a87f0f5e5945fc4cd885bfb33d6c9f3261a116935461f9990607155d43c5968"
      }
     ]
    },
    {
     "n": "P",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "DOSBox-X reaches the register through the four ports of TandyDACWrite and TandyDACRead installed at 0x00C4.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "346-347",
       "sha": "f0c0fa71ad3a56ebb9381413b7fdd05763acf0c29061f89bf0e9b3b3c3d499cc"
      }
     ]
    }
   ],
