   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "Bits 0-3 of 00C7h hold frequency bits F8-F11.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1990-1998",
       "sha": "522b24b23923af4519382563791179c28a7fc71030e8960ac5e9084af99c3f61"
