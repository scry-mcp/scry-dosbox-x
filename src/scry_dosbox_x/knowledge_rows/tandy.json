   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "Ports 00C0h-00C3h take writes to the sound chip, an SN76496 tone and noise generator.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1807",
       "sha": "73baae9f3280be5d0eda752bd5169a08fb84e4e5914e9d6dd3b72088ac5b5128"
      },
      {
       "ref": "rbil61:PORTS.A",
       "lines": "9392",
       "sha": "8749f045c86bcb6f69fadb6b3d7b065404e94e03757f50f34f790599eb50f129"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "7032",
       "sha": "fbb43718adacb9332e99d7189468fb4543ac8959f56a8d5b9ddcf4d04bb94d78"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The first byte carries the three-bit register address and the data that go with it.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "298-301",
       "sha": "603f2df575aeeba23668739f774135dd5409027bf25d54901b9780ab9cb83b27"
      },
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "315-317",
       "sha": "6f2cf565538f47ddb6c8e04778072175f6748f0752c98eb78f572a4019c208d0"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A later byte without the address goes to the control register the address stayed latched on.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "294-297",
       "sha": "ec07f38e84ce826f3c016789bb1c3e0dcfdeaba04cdd7297e78e201f750dc5ec"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A frequency needs two bytes, the second holding the rest of its ten bits; an attenuation needs one.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "291-293",
       "sha": "451fc1da78f28066880a2a1c801d643a131dbcde2b504b64071553e2c2e91056"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1877-1878",
       "sha": "9dd3b3dd899e9372849348c25f459e5a06eaf097945a3e4beb0767c3f6af71be"
      },
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "315-317",
       "sha": "6f2cf565538f47ddb6c8e04778072175f6748f0752c98eb78f572a4019c208d0"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The eight control registers are the frequency and attenuation of each tone, then noise control and noise attenuation.",
     "quotes": [
      {
       "ref": "datasheet:SN76494.raw.txt",
       "lines": "302-312",
       "sha": "4aa02e0603a0752c0e6f48f3cdf38b342f4b83c894d489f81453d3fade12e99f"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The bytes the port names: update of tone 1 frequency and attenuation, the same for tones 2 and 3, and of noise control and attenuation.",
     "quotes": [
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1875-1886",
       "sha": "1a8f71ad564e19a9fdae55e1be25e4d1d0f4d1275c29501ec08d42d7c550e2be"
      },
      {
       "ref": "datasheet:Tandy1000SL-Technical-Reference.raw.txt",
       "lines": "1887-1896",
       "sha": "197fc0a2c7da52b968bd148b8e598377564250e0358a3e7aa70a41b526f04912"
      }
     ]
    },
    {
     "n": "D1",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "1",
     "text": "DOSBox-X installs the write handler on 0x00C0-0x00C1 only, so a write to 0x00C2 or 0x00C3 reaches no sound chip.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "342",
       "sha": "174a7b0cc5ec5cd82fdfddb6239c44422fb8b3bdfda4249ed4b29b6870ea17c6"
      },
      {
       "ref": "dosbox-x:include/inout.h",
       "lines": "155",
       "sha": "76cce2d4666bd2ff6a265c2efbe9e9a468649b35ed2a2c98417bb913a2bbae02"
      }
     ]
    },
    {
     "n": "D3",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "On the Tandy 1000, the NCR8496 drops a byte without the address when it goes to an attenuation or the noise control register.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mame/sn76496.cpp",
       "lines": "323-329",
       "sha": "504ce64ac10dfe2f5267997a5cd98464bde6a8450034561b88d94c5be3fdeb4d"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "310-312",
       "sha": "0e47e730ae6e5c55f0213b72bab89f5ba09b671e52dfd1475e9d78157ef23193"
      }
     ]
    },
    {
     "n": "D4",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write to 0x00C0 also enables the Tandy channel and makes the mixer render the samples due before the change.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "74-85",
       "sha": "c057d2222fd5ccf1da3d0b76a2911a0cd52887af0d13004dd67cec800ce73d63"
      }
     ]
    },
    {
     "n": "P",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "DOSBox-X reaches the chip through SN76496Write, installed at 0x00C0 when Tandy sound is enabled.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "314-322",
       "sha": "1c88e8ec26730e2e247d87c103b15c4650248bf07270467512ffb3658e4de444"
      },
      {
       "ref": "dosbox-x:src/hardware/tandy_sound.cpp",
       "lines": "342",
       "sha": "174a7b0cc5ec5cd82fdfddb6239c44422fb8b3bdfda4249ed4b29b6870ea17c6"
      }
     ]
    }
   ],
   "closed": [
