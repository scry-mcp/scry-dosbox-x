       "sha": "a3108e2206e5d29e15b5e32fc12ff78dc20396b522fe858ccc3370e2c39d481e"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Bit 4 is reserved.",
