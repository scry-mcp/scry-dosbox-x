    },
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "2141-2146"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "719"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "721"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "135"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "288"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "function": "MPU401_ReadStatus"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "184-188"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "With RD* low the port is read as STATPORT and with WR* low written as COMPORT.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "275",
       "sha": "d140e64ae3266b36b6306bfecfa2e671832fd5b79348166255fe3d4ace8d980c"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "276",
       "sha": "4fbe468f8f03aa3eabc15b8fad1c7a345dd708049e1c29e399468464988b51bc"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "A read of the status port returns the MPU status byte.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "275",
       "sha": "d140e64ae3266b36b6306bfecfa2e671832fd5b79348166255fe3d4ace8d980c"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "2144",
       "sha": "4cba9d2a793707dd6f263593ceefab6f4e4fd993d7e23cdcd6279f32f53d093b"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A write to the command port sends an MPU command.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "276",
       "sha": "4fbe468f8f03aa3eabc15b8fad1c7a345dd708049e1c29e399468464988b51bc"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "2145",
       "sha": "7266521c70c516f40394e6b037df679da20a1c972bb465d2636cb3f6ba8a6b6a"
      }
     ]
    },
    {
     "n": "4",
     "on": "bits 7-6",
     "of": "doc",
     "text": "Bit 7 of the status byte is DSR and bit 6 DRR, both active low; the table's footnote reads ORR* for DRR.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "284",
       "sha": "61e1adb6b9a083b5d1884c259e5b569ca87297e21d306331c4265fcc7795c528"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "2142-2143",
       "sha": "616b884a1fe7355156acebb38e864f7fe576f51f9995d57752bbffb14e67e2ab"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Normally A1 and A2 are zero, as the MPU-401 hardware connects as port 0.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "285-286",
       "sha": "aaddb2d7c1202f7f387e4dfa1808c4e8b4b196f58fc6ef62c6c646cc32a18e9d"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "All MPU data bytes are sent to or read from DATAPORT.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "2146",
       "sha": "9b096804476357d6dca827491a6e1a674b47a41e5000e48cc0f46e880f157492"
      }
     ]
    },
    {
     "n": "7",
     "on": "place",
     "of": "dosbox-x",
     "text": "The command port's write is MPU401_WriteCommand and its read MPU401_ReadStatus.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "719",
       "sha": "78676f89cc8c9ccf127d6614c8b98fd2208fd5bcf3bcbceffd4a4e0f009170fb"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "721",
       "sha": "f166f6348ae4fa3f7ac21a71b3a1096e59e17ee706b02466ceae3ab26bc93ea8"
      }
     ],
     "vs": "place"
    },
    {
     "n": "8",
     "on": "write",
     "of": "dosbox-x",
     "text": "In UART mode a command write is ignored unless it is 0xFF.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "135",
       "sha": "d5a8ca21afbdd381bda06c5eca66ad3cdb04c9de2c66a921a7bb2edceb877201"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "9",
     "on": "write",
     "of": "dosbox-x",
     "text": "An accepted command ends by queueing the acknowledge 0xFE for the host.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "288",
       "sha": "233325b7eaa703784d269f25239a9582180795bb6605b40ad65513e69832c7cc"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "63",
       "sha": "d9347e78eda3a069c8e10cb7ef2550fee20cde346e7450bd00c185a9f9197ec2"
      }
     ],
     "vs": "extra"
    }
   ],
