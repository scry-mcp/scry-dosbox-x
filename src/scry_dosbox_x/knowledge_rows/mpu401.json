 "entries": [
  {
   "key": "0x330",
   "name": "MPU-401 data port",
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "267-274"
    },
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "2147-2149"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "718"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "720"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "function": "MPU401_ReadData"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "329"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "397"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A0 = 0 with RD* low is the data port the manual calls DATAPORT.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "269",
       "sha": "d1398d69a42456693060edd7ef0a37b2e048796ef73d1c821b3cd35eea4883cf"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "271",
       "sha": "0192e23ace68318e0d12f3d63c561f8241e0b581f9272790059ed41dcb088e75"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "With RD* low, the port at A0 = 0 reads DATAPORT.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "271",
       "sha": "0192e23ace68318e0d12f3d63c561f8241e0b581f9272790059ed41dcb088e75"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "With WR* low, the port at A0 = 0 writes DATAPORT.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "272",
       "sha": "f2bf8d01da0b9470c30448ed4a74cd16704dc2df90bb149283886cefc4d7e753"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "After the reset the data port must be read to clear the DSR before interrupts are enabled.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "2147-2149",
       "sha": "be7bff68f792e9bde59c0843e88c070fb5258260f9402a3c93cfbc6117164e04"
      }
     ]
    },
    {
     "n": "5",
     "on": "place",
     "of": "dosbox-x",
     "text": "The base port's write is MPU401_WriteData and its read MPU401_ReadData, as an IBM PC MPU-401.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "715",
       "sha": "2c773907ea5ce1398593906d4d876823c9e532586a994fdfc9a1c445a7a2da91"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "718",
       "sha": "9fc500cca00499e47496530ad1c290df9729f987e5b9bb6ef8a311a4c8278459"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "720",
       "sha": "fd1475d4a43d28adeaf83cc52a2856064657f7b9fbbba449b1922578ab1c67b8"
      }
     ],
     "vs": "place"
    },
    {
     "n": "6",
     "on": "read",
     "of": "dosbox-x",
     "text": "A read returns 0xFE when the queue is empty, else pops the queued byte, and in UART mode returns it at once.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "294-300",
       "sha": "2f5626af09f0e1e862fc5973b3c007218f23f0d120737e942eb8165c18bebb47"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "323",
       "sha": "67f6db9d4a2e640b2fa88b7ad8e8f66bbcfe38eae9b1e4d974aaa66f5be96cc8"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "63",
       "sha": "d9347e78eda3a069c8e10cb7ef2550fee20cde346e7450bd00c185a9f9197ec2"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "7",
     "on": "read",
     "of": "dosbox-x",
     "text": "A read that leaves the queue empty calls PIC_DeActivateIRQ to clear the IRQ.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "302",
       "sha": "1be5fbae077e925846dd4b68b12c8d1f8b0c7917af49c3073adfaad6dc86be0e"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "8",
     "on": "read",
     "of": "dosbox-x",
     "text": "A read of 0xF0-0xF7 takes the channel from the low three bits and clears the conductor request.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "304-307",
       "sha": "33f26f3bf0501a162f691ceadfc93719c5d90057a04a6468ac34e9682cf6f612"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "9",
     "on": "read",
     "of": "dosbox-x",
     "text": "A read of 0xF9 with a buffered command calls MPU401_WriteCommand with its first byte and MPU401_WriteData with the second.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "309-317",
       "sha": "1a6f490d5c3a5c12388a1a1553a30247f0beff75f4c69351a4c8ff0164c64b8a"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "60",
       "sha": "fd2050ba354050b4f10fccad1ab191a96bb9d0f7d4e751ea0dae5c81e19debb4"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "10",
     "on": "read",
     "of": "dosbox-x",
     "text": "A read of 0xFC, 0xFD or 0xFE calls MPU401_EOIHandlerDispatch.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "319-321",
       "sha": "84a4a6086d0253fb524270944197cac25749d94749c7fb5d8499dfdb5a7e6e7c"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "61-63",
       "sha": "2ce757d75d00c38184501541c12c1fbb603ae4a8d4d921e33884fae8b948ef87"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "11",
     "on": "read",
     "of": "dosbox-x",
     "text": "QueueByte and ClrQueue write the queue_pos member that a read also advances.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "110-111",
       "sha": "0a88015f75e858e09edee854ecdac813b07c73f77a6d08dde3f05b4dc992eb3a"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "119-120",
       "sha": "95c4dd00dc52eca730cdd6b39b26990c98b5db56ef46c30f850588950b35b75f"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "298",
       "sha": "89b14dab26af871edc908cb6133723993779a8df7899cf6a5985bb2ff0fb5d73"
      }
     ],
     "vs": "extra"
    }
   ],
