  {
   "key": "0x331",
   "name": "MPU-401 cmd/status port",
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "275-277"
    },
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
