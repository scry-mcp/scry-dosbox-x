 ],
 "entries": [
  {
   "key": "0x3B0..0x3B7",
   "name": "CRT controller blocks",
   "aliases": [
    "CRT address and data ports"
   ],
   "regions": [
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "3055-3061"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_misc.cpp",
     "lines": "111-137"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_crtc.cpp",
     "lines": "62-79"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "A write to the Address register stores the index that selects the data register.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3055-3056",
       "sha": "732988bb8df3dd2fc966a780fb9951d2b478092cda39516e7afde58e85b3c9c4"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The Address register is at hex 03B4 or 03D4 and the access port at hex 03B5 or 03D5, the I/O address bit picking the pair.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3055-3061",
       "sha": "7951acb9acd5882504357f86681424ad4d732c04ab8d6a05a59f0e178d20cd16"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The question mark is the variable part the I/O address select bit sets; the capture prints B as 8 and I/O as 1/0.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3055-3061",
       "sha": "7951acb9acd5882504357f86681424ad4d732c04ab8d6a05a59f0e178d20cd16"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A read of the Address register returns the stored index through vga_read_p3d4.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_crtc.cpp",
       "lines": "40",
       "sha": "efe0c0d9b8f07934d7fe7a2ecbe3c7b870ba48a4bf3017e2d83d3113fde6ac4f"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_crtc.cpp",
       "lines": "65",
       "sha": "5631ab1bdca6d2929afa6cc377d676b4d05bf1e1166de944b40654382dd526a4"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_crtc.cpp",
       "lines": "72-79",
       "sha": "dec41e51e6a6fa061b50f2b8142ad8ea36a2c9d5241a0deb5786e7eb4a041a78"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "A write to 03B4 or 03D4 goes to vga_write_p3d4 and a read to vga_read_p3d4; 03B5 or 03D5 goes to vga_write_p3d5 and vga_read_p3d5.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "113-116",
       "sha": "e5e6eaaef77d84a92a5fe213e90d211e832bbabf72699911dd79e63aac4591e5"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "118-126",
       "sha": "6cdc088fe901001801561a77f037ae71b714fe1d440075a7be308c8679de2ef3"
      }
     ]
    },
    {
     "n": "102",
     "on": "is",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "On the VGA build only the pair bit 0 selects answers; on the EGA build all four pairs of the block take the address and data handlers.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "113-116",
       "sha": "e5e6eaaef77d84a92a5fe213e90d211e832bbabf72699911dd79e63aac4591e5"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "118-126",
       "sha": "6cdc088fe901001801561a77f037ae71b714fe1d440075a7be308c8679de2ef3"
      }
     ],
     "row": "2"
    },
    {
     "n": "103",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write registers the pair in the block bit 0 selects, four pairs on EGA, and frees the same ports of the other block.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "113-116",
       "sha": "e5e6eaaef77d84a92a5fe213e90d211e832bbabf72699911dd79e63aac4591e5"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "118-127",
       "sha": "4ba5b15c4a177d45a61064623f1dc9b65b18687bf73fb23b0f69c3f2d4e6b1db"
      },
      {
       "ref": "dosbox-x:src/hardware/vga_misc.cpp",
       "lines": "129-136",
       "sha": "b3aa1bcd4344074b31d41757b83930cb7320d0d5facc1d77c3cbe41f67170985"
      }
     ]
    }
   ],
   "closed": [
