  {
   "key": "0x01",
   "name": "status port",
   "regions": [
    {
     "ref": "datasheet:DisneySoundSource-PG.raw.txt",
     "lines": "37-40"
    },
    {
     "ref": "dosbox-x:src/hardware/disney.cpp",
     "function": "disney_read",
     "case": [
      "1"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The status port reports the state of the FIFO to the program.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "37",
       "sha": "d04b46bf8bee38c8253f300b4bcff482c2a4eb824b6e66fa26629b23a3303837"
      },
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "39",
       "sha": "50a33d0142619c6c1e47d8e71c538e37288c1757203b807bff8b4e843bf32b00"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "Pin 10 is high while the FIFO is full, so while it is low more samples can be sent.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "39-40",
       "sha": "83b05d02a60a0990419ecc7175c639ff15b4eb3e614185e791396fbde5195705"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "A read returns 0x07, after six control edges sets 0x40 and clears 0x04 while the leader buffer holds at least 16, and sets 0x80 when data bit 7 is clear.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "286-294",
       "sha": "545788a0a5733e6f340b10fe5b57ea16521c4ffd3235b4b5185849ec517bb84f"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "251-259",
       "sha": "92f369de10a2d7b149632fec0996f9927a5fb49835936711f7fd4b3d43a09383"
      }
     ]
    }
   ],
   "closed": [
