    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The data port carries eight-bit sample data to the D/A converter.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "27-28",
       "sha": "5db893bbf6076131eb434b624ce27fd05b1536186d79db34a7b646c0625300ea"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A byte written to the port is loaded into a 16-level FIFO.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "28",
       "sha": "fc79a411027d6d4ff15a8f1284e11642ddc88d0175a8fe33ff19dc6a78082db0"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "The FIFO clocks its data to the converter at the fixed rate of 7 kHz; the scan prints its tolerance as '5ft'.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "29",
       "sha": "4341d6964b0392426c2b10e115e3d23ffab6699ae95c25fdbd70b985b83d4e77"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "A write stores the byte in the data latch and, from the sixth write on, appends it to a 128-byte channel buffer, not a 16-level FIFO.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "36",
       "sha": "46bb5fdc229c533f04c7388fec9441770b2da193516f531a95b2fd366436eb08"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "204",
       "sha": "e568334cae52af2277dd21bfa2348c058dd95a9d0be66c9a75f234699d54e52d"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "207-210",
       "sha": "c2a1a476826984fe6d2ad32f53adcaf26771cfc398bf6d17dc3ddeae34ba991f"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "213-215",
       "sha": "186bae03b394e0e4a5d4ca57f9aa2f6bc041e7a2ae76c0859524337a337c0c13"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "The rate is not fixed: it times the gaps between writes and plays at that rate, accepting 500 to 100000 Hz.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "163-173",
       "sha": "6cb2ed0d7015b70b2ad3109453dbc6fa97d049bed0701a84fee64c748b8e58e6"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "148-152",
       "sha": "d3414c6a3e7ab1001f97fa7096d04461dc7e5819d26ed542f6967704f962a5b5"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "159-160",
       "sha": "c74742a2e4483e49fca9298a1baf8a25d7a02c6095aa8d637dacfa0754f7623d"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "93-99",
       "sha": "c5f83f583a338ccf503ad36f3c39d4dbcce93e767ad78f537780d6b5cbc19d7a"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "100-108",
       "sha": "2a372321756496c18eb7e9b6b78c1b484dfb1d377ec6f0ef86ec93d63d75ad1b"
      }
     ]
    },
    {
     "n": "6",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A read of the port returns the last byte written.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "204",
       "sha": "e568334cae52af2277dd21bfa2348c058dd95a9d0be66c9a75f234699d54e52d"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "282",
       "sha": "53c4b2d15f71690829199adfb984d4ef45891931471a347aa6376e9f7271970a"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Eight-bit unsigned data converts to an analog voltage, with 128 at the mid level.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "33",
       "sha": "8adb7e836372de70f4cd28ec08217038596420947208680e42e2e452db335318"
      },
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "35",
       "sha": "8f13ad88b9d5a550c1cfc7bb103733c40fe5e9e5f8f1a2b8377ffd45d28e3f9f"
      }
     ]
    }
   ],
