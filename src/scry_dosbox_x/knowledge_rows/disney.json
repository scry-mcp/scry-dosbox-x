  {
   "key": "0x02",
   "name": "control port",
   "regions": [
    {
     "ref": "datasheet:DisneySoundSource-PG.raw.txt",
     "lines": "17-26"
    },
    {
     "ref": "datasheet:DisneySoundSource-PG.raw.txt",
     "lines": "30-32"
    },
    {
     "ref": "datasheet:DisneySoundSource-PG.raw.txt",
     "lines": "51-58"
    },
    {
     "ref": "dosbox-x:src/hardware/disney.cpp",
     "function": "disney_write",
     "case": [
      "2"
     ]
    },
    {
     "ref": "dosbox-x:src/hardware/disney.cpp",
     "function": "disney_read",
     "case": [
      "2"
     ]
    },
    {
     "ref": "dosbox-x:src/hardware/disney.cpp",
     "lines": "404-422"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The SELECT line controls the speaker box's power supply, turning the Sound Source on when it can source current.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "17-19",
       "sha": "35855bccbfd735952c7822e3d3fe90786f4226a2bec218665abd99089228a876"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "Turning the Sound Source on makes a pop on the speaker, from power reaching the amplifier.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "22-23",
       "sha": "8a7a2afbc9ea648e68b15f53b0265dec5f2b8e58008be55c63411fc31664dd4b"
      }
     ]
    },
    {
     "n": "3",
     "on": "reset",
     "of": "doc",
     "text": "SELECT is connected to pin 17 of the printer interface, which the BIOS sets low at power-on and reset.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "24-25",
       "sha": "3c96146fb7df7304ed0589c62cfd7579c20d2e766ac83ebb49c5df69554430ef"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The program should return pin 17 low before returning to DOS.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "26",
       "sha": "d06d7fb65adc7ab705afe52a44b7d550221f018676fdd51904fae1d0ec2c4317"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "The code 04h powers the Sound Source up and 0Ch (printed OCH) powers it down.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "55",
       "sha": "2fae69b80b001f66c64afeb99e5420307573b463a0b1e0eab4a07c6d92f891ad"
      },
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "56-57",
       "sha": "fe35448fee479db2f17c72d167e1e35bfa356b855feb4b68d178d60457a0ae05"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "The code 0Ch strobes the D/A chip as a pulse on SELECT of one to ten microseconds.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "20-21",
       "sha": "94117fa96111a3e52833b8e804609fb95145e8d742408e8e4b68dcafc01b8813"
      },
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "58",
       "sha": "bade68c8581d376b026c21dd07567520b2ad47a99ea11b011889053104217061"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "doc",
     "text": "The pulse on pin 17 from the printer interface clocks data into the FIFO.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "30-32",
       "sha": "635ae82f25258df8275d4b81c142569520ad3a6d16fb0a3fbe47ec30469799a4"
      }
     ]
    },
    {
     "n": "9",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "5",
     "text": "A falling edge of bit 0x08, once six have been counted, enables the mixer channel at 7000 Hz.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "251-259",
       "sha": "92f369de10a2d7b149632fec0996f9927a5fb49835936711f7fd4b3d43a09383"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "271",
       "sha": "b6fb2d1046c1795cc5104647edd5b908fa0f79355b0daa84cde50b6eaad45c18"
      }
     ]
    },
    {
     "n": "10",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "6",
     "text": "A falling edge of bit 0x08 queues the last data byte for playback once six edges have been counted, rather than strobing the D/A chip.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "251-259",
       "sha": "92f369de10a2d7b149632fec0996f9927a5fb49835936711f7fd4b3d43a09383"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "261-266",
       "sha": "f826ad508aebbf081c291677e6df2330e088e244d375fa06ea970113f87484a4"
      }
     ]
    },
    {
     "n": "11",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "7",
     "text": "Once six edges have been counted, the byte is queued on a falling edge of bit 0x08.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "251-259",
       "sha": "92f369de10a2d7b149632fec0996f9927a5fb49835936711f7fd4b3d43a09383"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "261-266",
       "sha": "f826ad508aebbf081c291677e6df2330e088e244d375fa06ea970113f87484a4"
      }
     ]
    },
    {
     "n": "12",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A falling edge of bit 0x02 latches the data byte into channel 1's buffer, and a falling edge of bit 0x01 into channel 0's.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "224-234",
       "sha": "9e3d10d41253a4a3faf2aabdf9e281fb03326785e10dfe9ad1aa8a9d40d0bed0"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "238-249",
       "sha": "f28182c81c61dd101aa7606d9a078998ed872f22c5f2c650cdbe040575bbaf2b"
      }
     ]
    },
    {
     "n": "13",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A set bit 0x10 logs that the parallel IRQ is enabled.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "270",
       "sha": "e78364d80cd7bd3b28959f96943d361495f99dbf4dbf16fefaea3115263861bd"
      }
     ]
    },
    {
     "n": "14",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The whole byte is stored as the control register, and a read of the port returns it.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "271",
       "sha": "b6fb2d1046c1795cc5104647edd5b908fa0f79355b0daa84cde50b6eaad45c18"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "298",
       "sha": "f98fa2de59ab0197f0efc1382a7a94e5cc9c565406a560e27e443ef1d8f6ea0a"
      }
     ]
    },
    {
     "n": "15",
     "on": "is",
     "of": "doc",
     "text": "A low pin 17 turns the Sound Source off.",
     "quotes": [
      {
       "ref": "datasheet:DisneySoundSource-PG.raw.txt",
       "lines": "24-25",
       "sha": "3c96146fb7df7304ed0589c62cfd7579c20d2e766ac83ebb49c5df69554430ef"
      }
     ]
    },
    {
     "n": "16",
     "on": "reset",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "The control byte is zeroed once, when the module is constructed; a machine reset does not re-run the constructor.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "411-422",
       "sha": "3c574c4bb711dfd534736416d89f5085b70892a2553288a0c0279d28d2c46c29"
      },
      {
       "ref": "dosbox-x:src/hardware/disney.cpp",
       "lines": "465-471",
       "sha": "20d72823af1262d07efdc16b5dba6d95dd1a888a85a332b09534585a13304392"
      }
     ]
    }
   ],
