   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "All command parameter information and disk data transfers go through the FIFO.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "816-819",
       "sha": "bd4bb03a6e549ad21091250a84a8cb5d26a63125e846d338a15c1b484187334c"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The FIFO is 16 bytes in size with programmable thresholds, and data transfers are governed by the RQM and DIO bits of the Main Status Register.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "817-821",
       "sha": "4e00b505971ceb52a96c3fef6cc831d63d04e1b9eb3f10e41053879701d1be4f"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Data transfers are governed by the RQM and DIO bits of the Main Status Register.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "820-821",
       "sha": "f1ae77d615182020fb0a1ae45b27ad242ef46e8a7504e84486def497bac04901"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "2",
     "text": "The emulator's data port hands each accepted byte directly to fdc_data_write, which stores it as a command byte or parameter, guarded only by its ready flags.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2608-2617",
       "sha": "87ebbaa4a3944bb6e0d7f1522ac6480f90f996d8ac7c12c3f2f17784896984a5"
      },
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2203-2210",
       "sha": "8321dc160f5bc5aeeb0fca954b7bbdd1aa4630aa63e16eda2700f2bbb664c821"
      },
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2381-2383",
       "sha": "cb494ee8ddfd0e3aa0cdfbfd088a2b076c21af6352f837699ca36726988e4272"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A read when the controller has no result byte ready returns 0xFF.",
     "quotes": [
