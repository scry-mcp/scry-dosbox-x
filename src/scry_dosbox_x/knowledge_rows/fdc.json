    {
     "ref": "dosbox-x:src/hardware/floppy.cpp",
     "lines": "1201-1205"
    }
   ],
   "rows": [
    {
     "n": "0",
     "on": "is",
     "of": "doc",
     "text": "The Digital Input Register is a read-only register; in the PC-AT mode only bit 7 is driven.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "866-869",
       "sha": "8a2561785cab31c01e99f516f9404003f64c501669597ac71e3547191a11c18e"
      }
     ]
    },
    {
     "n": "1",
     "on": "read",
     "of": "doc",
     "text": "The Digital Input Register is read-only in all modes; in PC-AT mode only bit 7 is driven and all the other bits remain tristated.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "866-872",
       "sha": "1d789c8a9badbb1ba8fd221a221ae7e72676a9ffff835c6e130244f195f611f3"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "In PS/2 mode bits 6 to 3 return 1 and bits 2 and 1 return the current data rate.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "884-893",
       "sha": "1354c1630303e104a6c05d9a8cf47b08bca967fd015ebc0dd8bcaead658686ba"
      },
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "909-911",
       "sha": "acebd2fe1c7e0767a4eeccb2d9bd5941d60cb2456a683769f179e14541fbf482"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "HIGH DENS (bit 0) is low whenever the 500 Kbps or 1 Mbps rate is selected, independently of the IDENT and INVERT pins.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "894-896",
       "sha": "8b67df15d8e45d1ea186c6a3dba2e2fc76d974b948636f0960b03bcd1b1ebf84"
      },
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "909-911",
       "sha": "acebd2fe1c7e0767a4eeccb2d9bd5941d60cb2456a683769f179e14541fbf482"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "In Model 30 mode bits 6 to 4 return 0, bit 7 is inverted, bit 3 reflects the DOR's DMA GATE and bit 2 the CCR's NOPREC.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "925-936",
       "sha": "6a2f1017a9b27d87ff6b454660be46942d7520d6e7a7dac7376d9bf97991fbea"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "The Configuration Control Register sets the data rate and is write-only; in the PC-AT the capture names it the OSR.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "937-939",
       "sha": "ab4d147bfb650cf6625296d44567e16742a65230e54b954f5cf5197521a9f769"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "1",
     "text": "In PC-AT mode the emulator returns 1 in bits 6 to 0 instead of leaving them tristated.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2425-2427",
       "sha": "18dfc377ce728a01d05ab720401333c7e145d4868aaeead45c1a584fd3fd3ef0"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "4",
     "text": "In Model 30 mode bits 6 to 4 return 0 and bit 7 is inverted; bit 3 returns the DOR's DMA gate, but bit 2 reads 0 whatever NOPREC holds.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2422-2424",
       "sha": "3dc46c95d4bcd80c59571b5a612fd582bb8725da2ee3e1b8756beabc5598cc8b"
      }
     ]
    }
   ],
   "closed": [
