  {
   "key": "0xBE",
   "name": "PC-98 mode register",
   "aliases": [
    "dual-use FD I/F mode"
   ],
   "source": "emulator",
   "searched": [
    {
     "where": "mame-header",
     "gave": "MAME's pc_fdc and upd765 headers name no document; pc9821.cpp maps port 0x04BE to a 3-mode handler and cites none."
    },
    {
     "where": "maker",
     "gave": "NEC publishes no online register manual for the PC-98 floppy interface; only the printed Technical Data Book was found."
    },
    {
     "where": "bitsavers",
     "gave": "bitsavers.org's NEC and floppy directories hold drive manuals and no PC-98 interface register table."
    },
    {
     "where": "archive-org",
     "gave": "The PC-9800 Series Technical Data Book HARDWARE 1993 gives 00BEH as mode change and mode status, but its OCR table is garbled and it names no 04BEH."
    },
    {
     "where": "index",
     "gave": "Datasheet indexes gave no NEC PC-98 floppy interface register table."
