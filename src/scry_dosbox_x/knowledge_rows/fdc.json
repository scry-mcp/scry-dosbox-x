   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "Register 0x00BE is the PC-98 dual-use floppy interface mode register.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2542-2546",
       "sha": "306eeca8fdb20ceb0a085de50fc83de6b73c47a40d701ba42e4d9233fc5f86a7"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write stores the low three bits: bit 0 picks 1 MB when set, bit 1 the access mode, and bit 2 enables motor control, clear leaving it always on.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2548-2552",
       "sha": "96fca85a91f5544d0ea5c4df5751667c39d9b0f2677424ebc9d6b03b7b2bac13"
      },
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "739-741",
       "sha": "ca31f8a9955e9563343f54389bbe05e6dc3066ed15b6325ea4de4fab7b4d0570"
      },
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "743-745",
       "sha": "7f586d751f87e4c22806d05de26f7f055092d591e2bc69de3ad35bc9864fee4f"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A read returns 0x08 in bit 3 and the stored low two bits; the motor-control bit is not returned.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2555-2558",
       "sha": "fda9c3b18f95fef0f9fde4d8c6d4f00f86b12a341ec4431accc87576c6970055"
      },
      {
       "ref": "dosbox-x:src/hardware/floppy.cpp",
       "lines": "2560-2561",
       "sha": "21ab1b4082b26900561aec9eff4f9b8f4c254adb3b64ff1aba3fd24e4f3895fe"
      }
     ]
    },
    {
     "n": "4",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "Ports 0x00BE and 0x04BE are installed only for the first PC-98 controller.",
     "quotes": [
