    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "At the same address a write goes to the Datarate Select Register, which is write-only and changes the timings of the drive control signals.",
     "quotes": [
      {
       "ref": "datasheet:82077SL.raw.txt",
       "lines": "575-584",
       "sha": "20973a6895bc97a1a68b02d772bbede7b4d6568577c536255daa7022a52ffed7"
