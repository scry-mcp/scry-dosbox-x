  {
   "key": "0x04",
   "name": "memory mode",
   "aliases": [
    "sequencer memory mode"
   ],
   "regions": [
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "3015-3053"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_seq.cpp",
