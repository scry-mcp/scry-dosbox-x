     "case": [
      "0"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Index hex 00 is the read/write Reset register at address hex 03C5.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2826-2828",
       "sha": "e16a2230d406fe430fef1e53ab54e1a0f4a272f6660c3773f912fc52d9ab759b"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write stores SR at bit 1: 0 commands a synchronous clear and halt, and bits 1 and 0 must both be 1 to allow the sequencer to operate.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2836-2838",
       "sha": "fb1941bb3f70d91cbe483d2389d3ffbb000b8cc3b797e84475f9da7ec6e11b5e"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "To prevent loss of data, bit 1 must be set to 0 during the active display interval before the clock selection changes.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2839-2842",
       "sha": "4855d5f498893f1490b27a3b6c16d5534e4a10637d5151922666e4be9622f4e4"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write stores ASR at bit 0: 0 commands an asynchronous clear and halt, which can cause loss of video data.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2843-2846",
       "sha": "a07a54df79dc3b5413c444c572cb3335f9f7c6154a01eb59b3c57be42ca6873f"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write first renders the pending output when render-on-demand is on, then stores the byte.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "147-148",
       "sha": "2c26dd5447ed20a5bb7a48aff3fe9e0552cf331d1abaa2cf96f3b142b7c36d12"
      }
     ]
    }
   ],
