   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The sequencer's data registers are at address hex 03C5.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2797-2798",
       "sha": "89c35f1cbdb0a086a74966b2af39965a25b5e9fabd9cf4a3188bd3498c87bf1a"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "All registers within the sequencer are read/write.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2798-2799",
       "sha": "cacabb85ee38a039f92db1351b4ba5b7bf8016f2b1c1464a27bb7b2b54fb416f"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write to the data port is ignored entirely when the VGA register lockout option is set.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "141-142",
       "sha": "2ac51aaef5d0cbe7a01ab858b54ef2de34df23538626a3a93ba02a1c573d48ab"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "An index the sequencer does not implement is passed to the SVGA handler; with none installed the write is logged as an illegal index.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "232-238",
       "sha": "55a0be1f9fa80f1173989d1d9208e5b94d78690c299eaa2c1d4a0f9646c82e47"
      }
     ]
    },
    {
     "n": "103",
     "on": "read",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A read of an index the sequencer does not implement is passed to the SVGA handler and otherwise returns 0.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "261-266",
