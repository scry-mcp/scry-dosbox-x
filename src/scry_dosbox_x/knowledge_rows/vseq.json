   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Index hex 04 is the Memory Mode register at address hex 03C5.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3015-3016",
       "sha": "532b8ad795ee1234e39bcc0176c62ee61e21ddb0172aec29723bdfe25724f432"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write stores CH4 at bit 3: on a system read, 0 walks a bit map via the Map Mask and 1 lets address bits A1-A0 pick the map.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3026-3031",
       "sha": "6fd05090f15a27bf4a765478e754489e35d20d4899d59f6382a0a6b0c87f22ed"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "In chain 4 mode, address bits A1 and A0 select map 0, 1, 2 or 3.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3032-3043",
       "sha": "67fda44e68a039f4fc6ca3386c07b35e35bb0b310c3cdb59065db622accee69b"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write stores OE at bit 2: 0 sends even addresses to maps 0 and 2 and odd to 1 and 3; 1 makes addressing sequential, per the Map Mask.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3044-3049",
       "sha": "af49911937979db1970c61182f1228e1f8d58bda5f3e02f25ac4f201e804930c"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "A write stores EM at bit 1: 1 enables video memory from 64KB to 256KB, and it must be set to enable the character map selection.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "3050-3053",
       "sha": "5a7221b847a32f4fdb08d1225b6cb44a7347d9e90cc48fcbcd66186c7a3ad61e"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write marks the complexity flags, then on VGA sets the chained flag from bit 3 and rebuilds the memory handlers.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "219-230",
       "sha": "b699125ebc7e919b0df05673bb39b3a2be43aa673990fe40569636ac85148aa1"
      }
     ]
    }
   ],
