  {
   "key": "0x3C4",
   "name": "sequencer address",
   "aliases": [
    "sequencer address register"
   ],
   "regions": [
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "2800-2825"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_seq.cpp",
