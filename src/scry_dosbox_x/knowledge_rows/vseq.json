  {
   "key": "0x01",
   "name": "clocking mode",
   "aliases": [
    "sequencer clocking mode"
   ],
   "regions": [
    {
     "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
     "lines": "2847-2902"
    },
    {
     "ref": "dosbox-x:src/hardware/vga_seq.cpp",
     "function": "write_p3c5",
     "case": [
      "1"
     ]
    },
    {
     "ref": "dosbox-x:src/hardware/vga_seq.cpp",
     "function": "read_p3c5",
     "case": [
      "1"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Index hex 01 is the read/write Clocking Mode register at address hex 03C5.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2847-2849",
       "sha": "e733762ccd2d89628be44f05e571e9b78b4c99d4e0d74826f45c54331887d709"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write stores SO at bit 5: 1 turns off the display and assigns maximum memory bandwidth to the system, keeping the synchronization pulses.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2867-2871",
       "sha": "a99505bd02711e4ca63178fdf1d124c1ec12193f1ef2507ffbf0e75541d29a5a"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A write stores SH4 at bit 4: with SH4 and SL 0 the serializers load every character clock; with SH4 1 every fourth, useful when 32-bit fetches are chained.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2872-2877",
       "sha": "9cde27f53ff4d6dec90130bdfb753e9a5a2d63f5d7e0f7336fe5df1b729d5256"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Extended Graphics mode behaves as if SH4 were 0, so programs should set it to 0.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2878-2879",
       "sha": "2f96842c78539debd547500fbe2d04062a7f768617c56dbb9327384dbdc1ad7a"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "A write stores DC at bit 3: 1 divides the master clock by 2 to make the dot clock, as the 320 and 360 pel modes use.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2880-2885",
       "sha": "91814994fc3589892cc81821e9e38920c1d1c4a23449fe30faa1f38b55305ae9"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "A write stores SL at bit 2: with SH4 and SL 0 the serializers load every character clock; with SL 1 every other, useful when 16-bit fetches are chained.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2886-2891",
       "sha": "cae66782f5da65e92f9b7ee6adac8ef193d4eaddb71999f83a2b06ef49c95e47"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Extended Graphics mode behaves as if SL were 0, so programs should set it to 0.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2892-2893",
       "sha": "2f96842c78539debd547500fbe2d04062a7f768617c56dbb9327384dbdc1ad7a"
      }
     ]
    },
    {
     "n": "8",
     "on": "write",
     "of": "doc",
     "text": "A write stores 8/9 Dot Clocks at bit 0: 0 generates character clocks 9 dots wide, 1 makes them 8 dots, and only the alphanumeric modes use 9.",
     "quotes": [
      {
       "ref": "datasheet:PS2-Video-Subsystems.raw.txt",
       "lines": "2894-2902",
       "sha": "7995c5d57630113d92db76ef88c4e3a74bc11755e54bdaeb647413f987b3a221"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A write of the byte already stored does nothing at all.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "151-162",
       "sha": "fff5c0b3d1f9692b829063ab40553d557591afc0a87804a9b38e87c7c16fd0b4"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A change in any bit other than screen off makes DOSBox-X resize the display.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "153-156",
       "sha": "e34b0c1bd3c982b622ee54c43cee394a015bfd9cbe38de5bee2a0b7506b172f3"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The blanking the screen-off bit asks for is skipped when the ignore_sequencer_blanking option is set.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/vga_seq.cpp",
       "lines": "160",
       "sha": "3288b69c2925a37cd4d2ba12c497ad3acde6cb1c9b77cd4c58424dd7e18899b7"
      }
     ]
    }
   ],
