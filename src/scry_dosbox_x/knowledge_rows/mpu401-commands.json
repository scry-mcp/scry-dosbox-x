     "as": "structure"
    }
   ]
  },
  {
   "key": "0xAC",
   "name": "Request version",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1077-1079"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "236-239"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $AC command returns one byte, the VERSION number in BCD; $15 is version 1.5.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1077-1079",
       "sha": "80fe7c243d393e664ebdc4cdffaaab0520194518866d6f138a853897bbc72148"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $AC makes the MPU-401 send the version byte back to the HOST.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1077-1079",
       "sha": "80fe7c243d393e664ebdc4cdffaaab0520194518866d6f138a853897bbc72148"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The command also queues an ACK (0xFE) before the version byte.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "236-239",
       "sha": "fc1852b5839facb0d4c1278f8942c48f4e273382082ec1fe621a96f95f3c0940"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "236-239",
     "as": "agrees",
     "row": "2"
    }
   ]
  },
  {
   "key": "0xAD",
   "name": "Request revision",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1080-1083"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "240-243"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $AD command requests the REVISION: the byte is 1 for 'A', 2 for 'B', and 0 when there is no revision number.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1080-1083",
       "sha": "d0db9579742b0b82eb8311afb04117dd3dea95bdb1681e3b845a97a4587474fd"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $AD makes the MPU-401 send the revision byte back to the HOST.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1080-1083",
       "sha": "d0db9579742b0b82eb8311afb04117dd3dea95bdb1681e3b845a97a4587474fd"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The command also queues an ACK (0xFE) before the revision byte.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "240-243",
       "sha": "0a968d4b54d459eacd6d5d202dbc7f2e5f1662d9b92fea522b2c14f7880c269e"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "240-243",
     "as": "agrees",
     "row": "2"
    }
   ]
  },
  {
   "key": "0xAF",
   "name": "Request tempo",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1084-1089"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "244-247"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $AF command requests the TEMPO in beats per minute; in MIDI or tape sync modes it gives the tempo set from the external source.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1084-1089",
       "sha": "6609b0452b5bbad1a10d951e8bc0c471d6a825824afead0bf037157dce8a41fd"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $AF makes the MPU-401 send the current tempo back to the HOST.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1084-1085",
       "sha": "529ccf9243461390b78d82cb8a3d8a1074c094ee0fdfbabd4806129d5926d06f"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The command also queues an ACK (0xFE) before the tempo byte.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "244-247",
       "sha": "8e6ce0af3c7b11cd1bdf26ae086b3effb3675832e8b8f1bfbd198c8659fdaf8d"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "244-247",
     "as": "agrees",
     "row": "2"
    }
   ]
  },
  {
   "key": "0xB1",
   "name": "Reset relative tempo",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1091-1093"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "248-250"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $B1 command resets the RELATIVE TEMPO to the ratio 1/1, the same as the $E1 $40 command.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1091-1093",
       "sha": "e295b0f99b41c94b7d2e1c63362f231212921d75d142d172d3c9a06da7ac9ead"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $B1 sets the relative tempo back to the ratio 1/1.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1091-1093",
       "sha": "e295b0f99b41c94b7d2e1c63362f231212921d75d142d172d3c9a06da7ac9ead"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "248-250",
     "as": "agrees",
     "row": "2"
    }
   ]
  },
  {
   "key": "0xB8",
   "name": "Clear play counters",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1094-1103"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "251-268"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $B8 command clears the PLAY counters of all tracks and the CONDUCTOR and clears the PLAY MAP, so no message goes out before the first START PLAY.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1094-1100",
       "sha": "9ce2fa5e1d6da9616be4acb0f2cc3b8dce3d745cb0ef6003130b660dfceb473e"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The command is not used to continue from the last stop, which remembers the old PLAY counter values.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1101-1103",
       "sha": "838d81343304956c637cbac1b5831a1c6ba8c0d7e421fd69592d6ccfbfa9527b"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Writing $B8 clears the play counters of all tracks and the CONDUCTOR, and the PLAY MAP.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1094-1100",
       "sha": "9ce2fa5e1d6da9616be4acb0f2cc3b8dce3d745cb0ef6003130b660dfceb473e"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "dosbox-x",
     "text": "It also sends an all-notes-off on channels 0xB0 to 0xBE.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "253-257",
       "sha": "7289209ef717e0a3653aa64235a74324ff86339104ade8a215c4fb4f43cbb5be"
      }
     ],
     "vs": "extra"
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "251-260",
     "as": "agrees",
     "row": "3"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "261-268",
     "as": "agrees",
     "row": "3"
    }
   ]
  },
  {
   "key": "0xB9",
   "name": "Clear play map",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1107-1122"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "251-268"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $B9 command sends NOTE OFF messages to MIDI OUT from the CHANNEL REFERENCE TABLES, clears their NOTE ONs, the PLAY TABLES and the PROGRAM CHANGE TABLE.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1107-1112",
       "sha": "b637fbd2d0cf1afbd18f042cac71fb1289961b58aea2d630768460e750f0df56"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1121-1122",
       "sha": "2a76cc124fb498ffd8d22fcbca1f53c8a0ca5fe40e8f6ea820ae36a54dfbf799"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The command is needed when the HOST sends data with the WANT TO SEND DATA commands while PLAY is stopped or on inactive tracks.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1113-1120",
       "sha": "cc0c6d0553fe23483f08f7fd0d06d23c93197348d75aa8b89367e3cf1ced8881"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $B9 sends the NOTE OFF messages of the CHANNEL REFERENCE TABLES and clears the PLAY TABLES and the PROGRAM CHANGE TABLE.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1107-1112",
       "sha": "b637fbd2d0cf1afbd18f042cac71fb1289961b58aea2d630768460e750f0df56"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1121-1122",
       "sha": "2a76cc124fb498ffd8d22fcbca1f53c8a0ca5fe40e8f6ea820ae36a54dfbf799"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "dosbox-x",
     "text": "An all-notes-off goes to channels 0xB0 to 0xBE, the play counters are zeroed and the play buffers cleared; this case names no program change table.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "251-260",
       "sha": "96fdb33067e3b8845cccf3fbc66c0fcefde330c2c1d66cf45bf19e715ddf5f99"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "261-268",
       "sha": "ee2d25c6632cd2718d71c460b40cb3f140e3d1c324dff6d1df46c9cafe0729d4"
      }
     ],
     "vs": "differs",
     "row": "2"
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "251-260",
     "as": "structure"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "261-268",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0xC2..0xC8",
   "name": "Set timebase",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1127-1136"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "205-225"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $C2 to $C8 commands select the internal TIMEBASE, the number of clock pulses the counters use per beat, one at a time.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1127-1130",
       "sha": "1c1c76c9c1a59726d1442e4231a35d3b3419f978dacf33b432b906a9b479dfd3"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The TIMEBASE is 48 for $C2, 72 for $C3, 96 for $C4, 120 for $C5, 144 for $C6, 168 for $C7 and 192 for $C8.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1131-1133",
       "sha": "25d4e23b46af7ead7ec979884e33af56a922d6351e7be3b267e1e2e83f2cc2e8"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "A TIMEBASE of at least 96 is usually recommended for real time sequencer applications.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1134-1136",
       "sha": "01f2b6475a205a4caa4bfa882fe927da59fbf82ea00615cacab31a1a542c3a4b"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Writing one of these commands sets the internal TIMEBASE to the value the table gives for it.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1131-1133",
       "sha": "25d4e23b46af7ead7ec979884e33af56a922d6351e7be3b267e1e2e83f2cc2e8"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "205-211",
     "as": "agrees",
     "row": "4"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "212-217",
     "as": "agrees",
     "row": "4"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "218-225",
     "as": "agrees",
     "row": "4"
    }
   ]
  },
  {
   "key": "0xD0..0xD7",
   "name": "Want to send data",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1137-1146"
    },
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1159-1163"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "175-181"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "374-403"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $D0 to $D7 commands take the least significant three bits as the track number, 1 to 8.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1142-1146",
       "sha": "dddaa8da924c841dd9eadbceb6cc38b5601da9798cac035a9babde094d9ef992"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "When sent these commands the MPU-401 expects a MIDI VOICE MESSAGE without a leading timing byte, of the number of bytes MIDI defines.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1138-1141",
       "sha": "a4a4bc698eaa5b3d49e3024c93f93f386b0320ca198cb64f211a9bc7be05415d"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The MIDI VOICE MESSAGE which follows must be in standard MIDI format, and MIDI RUNNING STATUS can be used for each track.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1159-1161",
       "sha": "79aeffa173ad1143f69a176f9bcb41f5f6131a869c4cbebed141bd0055e338ba"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The command must not be used on ACTIVE TRACKS while the MPU-401 is playing.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1162-1163",
       "sha": "549fcb49ecf98b67641f36be888bae4808be29ae18b0a183b718e375191ac21a"
      }
     ]
    }
   ],
   "closed": [
