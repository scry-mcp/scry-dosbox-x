  {
   "key": "0xDF",
   "name": "Send system message",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1174-1185"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "184-188"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "404-421"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $DF command lets the HOST transmit a SYSTEM EXCLUSIVE or COMMON message to the MIDI OUT port of the MPU-401; the capture interleaves the columns.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1174-1183",
       "sha": "6a321415d819fa18d5ba5b7668e897dfefeab8bdc7aa29200914c52a0e5cc3b5"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $DF sends the following SYSTEM EXCLUSIVE message, terminated by EOX ($F7) or another MIDI status byte, to MIDI OUT.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1174-1185",
       "sha": "5a86f58c5c4461eccb1c08561d0ad9ecad35230a6a93d8c45c3e2f30d6b4d7ff"
      }
     ]
    }
   ],
   "closed": [
