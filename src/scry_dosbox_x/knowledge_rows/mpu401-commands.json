    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "366-371"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $E0 to $EF commands expect one byte of DATA from the HOST, which the HOST must always send.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1191-1196",
       "sha": "1377b32249629276ef741c51ff3cf028e6b282d853aa114848548bd90eb8f630"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1290-1291",
       "sha": "35bece6d8f0aed8afea51620c086e187f82cff1780250c395d4813d75cf9bc7b"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "$E0 sets the TEMPO of the internal clock in beats per minute.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1194-1196",
       "sha": "6c60c181dd0e19dbffe51d4db58b1c5e339ab7ead22e56276a838afa6c56d9e4"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "$E1 changes the tempo temporarily; $40 gives the ratio 1/1, and $E2 sets the rate of the change.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1197-1201",
       "sha": "67ad73915e766d99014a7274543230ccbe6b2b0f5135b9112fee3f3c81b8a8de"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1208",
       "sha": "8fda1a263357a7de32b36f0a9b30e68ba4ba52b93e03c9b6a730906e6dc9d4e4"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1230-1231",
       "sha": "ac5c4cc9054757f9520b973867956b0006d171111d3e033ea2679b287a0036c1"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "$E4 sets the number of MIDI clocks per metronome beep; 24 makes the beep once every 1/4 note.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1232-1238",
       "sha": "12e3629a0f35c42661d0dd873e5b0c9862911d2683fe574e7d36ae796a4de509"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "$E6 sets the number of beats per measure from the MIDI clocks per metronome beep; a beep at 1/4 notes and a value of 4 make a four beat measure.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1238-1246",
       "sha": "274b656c9fb5263987c9dec49696e9b0ed84034e5d63ca0faf84265529483b7f"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "$E7 sets the number of internal clocks per CLOCK TO HOST: $FD goes out every N internal clocks, N being the byte divided by four.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1247-1252",
       "sha": "e3945ee66e3aa35957b6e0d8be6d5b2aa21b172df910c458672cde30860a8db8"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "The default of $E7 is 240, which is 60 internal clocks per $FD, or twice per beat.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1247-1254",
       "sha": "5674bc28349aa3296e78db668d8e89cf61746d0db5613ee74869fcc6694ef721"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "$EC sets the active tracks: bits 0 to 7 of the byte set tracks 1 to 8 to PLAY.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1261-1264",
       "sha": "19f759982da3a988c413d0beba6ed78cc81a80d6d4d428259de25c5e08c9e908"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "$ED sets the tracks whose play counter values are sent when RECORD ON is sent while playing.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1282-1285",
       "sha": "e310718a0eb6c9c120285e2155ce62108f31766f08269c1f4833d4e4692eaac9"
      }
     ]
    },
    {
     "n": "10",
     "on": "is",
     "of": "doc",
     "text": "$EE and $EF are bit-mapped bytes that turn the MIDI channels' voice messages on or off, 1 to 8 and 9 to 16.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1290-1295",
       "sha": "1f569096ca156c50fe334a74ef63a997ade64febf0a318bdc411d0c3c767b10f"
      }
     ]
    },
    {
     "n": "11",
     "on": "write",
     "of": "doc",
     "text": "Writing one of these commands takes the byte that follows as the value of the setting the command names.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1192-1193",
       "sha": "5b61c0ff05af708c37c3bba09f4712faa178836a5818a6118d31242e1b966405"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1195-1196",
       "sha": "8e7c845c45ec0d19153c95fb77d408ff1a418b46a6062327588b48094c84f0ea"
      }
     ]
    },
    {
     "n": "12",
     "on": "write",
     "of": "dosbox-x",
     "text": "$E0 stores the byte clamped to 4-250, and $E7 stores it shifted right by two.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "333-338",
       "sha": "c1a65037642655e65764b7e8e1b430157532fdfb3ccc3b1d04124ba92f34c387"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "344-347",
       "sha": "94da53fcdb8f42677f4e8ec1ff3c24dbb83bdca0be3e3932caf3c6ad38edef48"
      }
     ],
     "vs": "differs",
     "row": "11"
    },
    {
     "n": "13",
     "on": "write",
     "of": "dosbox-x",
     "text": "$E1, $EC, $ED, $EE and $EF store the byte as it comes.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "339-343",
       "sha": "3bae46ffb7966e7f2da7cb6749259fccbadbcc08232affc328ac27058dc8f914"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "348-359",
       "sha": "a877897794e0ca06b1e110f38a817dcc8cf180612fae75f4c9c3285e2f2109b4"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "360-365",
       "sha": "98026c93c61756a2089be46b6409bf55984af29edb5956b06e052e451ac8ba32"
      }
     ],
     "vs": "differs",
     "row": "11"
    },
    {
     "n": "14",
     "on": "write",
     "of": "dosbox-x",
     "text": "$E2, $E4 and $E6 clear the pending command byte and set nothing.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "366-371",
       "sha": "c7ebd7c2388d1b20e47e673b5422a5ec25b69bb02af2e1f2f2bf7e410d2cc38c"
      }
     ],
     "vs": "differs",
     "row": "11"
    }
   ],
