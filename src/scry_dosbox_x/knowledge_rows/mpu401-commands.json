  {
   "key": "0xA0..0xA7",
   "name": "Request play counter",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1074-1075"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "172-174"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $A0 to $A7 commands request the PLAY COUNTER value of tracks 1 to 8.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1074-1075",
       "sha": "ea591626211e32e9cea9326a10c5a7606ad8f439762cc6b9c0800924476f758a"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $A0 to $A7 requests the PLAY COUNTER value of tracks 1 to 8.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1074-1075",
       "sha": "ea591626211e32e9cea9326a10c5a7606ad8f439762cc6b9c0800924476f758a"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "dosbox-x",
     "text": "The counter is queued only when the play counter mask $ED selects the track.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "172-174",
