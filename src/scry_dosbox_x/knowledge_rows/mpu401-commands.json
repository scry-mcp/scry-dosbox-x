   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Writing $8F switches CONDUCTOR ON.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "991",
       "sha": "eb64c440e49b22a521943a00c8afb82802a90b92540c4dd5cc4094c1bf6ded8c"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "964",
       "sha": "41175fc09ee2693689549c583b7ab5ab856a844c033c200602658823ce9e483c"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "With CONDUCTOR ON, while in PLAY mode, the MPU-401 asks the HOST for conductor data by sending MPU MESSAGE $F9.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "992-1000",
       "sha": "2b8b529c5e5fc17464fd1da936ead147ecaebf92f13a8ebb55d24bde1d154bfd"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "CONDUCTOR ON should only be sent before the CLEAR PLAY COUNTERS command.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1001-1002",
       "sha": "08adaeea3a0c2e529a096b0b0272b4ecf24a04f60133366fe665990ea77be8f6"
      }
     ]
    }
   ],
