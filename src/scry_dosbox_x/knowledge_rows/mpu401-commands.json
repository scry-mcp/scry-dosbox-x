 "entries": [
  {
   "key": "0x00..0x2F",
   "name": "Mode commands",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "552-563"
    },
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "695-735"
    },
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "737-749"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "146-149"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "151"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "152-170"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A mode command $00-$2B is 00aabbcc: bits 4-5, 2-3 and 0-1 select recording, playback and a MIDI real time message, which may combine.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "552-563",
       "sha": "7115625641aa5e250f66aed04f6133812a48ec2a408844d70306e1839ed034a2"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The table gives each mode command its MIDI, play and record action, and marks $00, $0C-$0F, $1C-$1F and $2C-$2F Do Not Use.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "695-706",
       "sha": "887125e24cafd559869ee03c04c12afa5d23e212f9390823ff5fc217ac808d97"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "707-718",
       "sha": "6340e823bc73afd412d9741f875a855fc1f8b5f79fb13ddbf6a7063c0e3151c0"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "719-730",
       "sha": "599f6124ec2ae03b0cce5fa66b73f719d448063a96ed28cee288d2183fd0392b"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "731-735",
       "sha": "ccda2a1092c1e0c7b39deb863e9cb0306e5f3003b50ff46a9e64700b4ca727fb"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Codes marked with a star are the most commonly used; others are usually not used alone.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "737-742",
       "sha": "5bf9f0da67d9a64f0f352da20ca774cd2aa93132ca35cf74d04814f79dac7fec"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Writing a mode command performs the MIDI, play and record action the table gives for its value.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "695-706",
       "sha": "887125e24cafd559869ee03c04c12afa5d23e212f9390823ff5fc217ac808d97"
      },
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "707-718",
       "sha": "6340e823bc73afd412d9741f875a855fc1f8b5f79fb13ddbf6a7063c0e3151c0"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "A command that leaves RECORD in stand-by turns RECORD on once a MIDI start or continue sets the timing condition.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "743-749",
       "sha": "6fa6069d6629fcaf4171c4e464cf9da31fb951eb89d0607b3c64b58522f9017a"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "dosbox-x",
     "text": "The MIDI and play halves are carried out, and a command with bit 5 set adds an error log line.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "146-149",
       "sha": "a6348b8c699238506d865ae2c5ea867f8c71f77c878af77e7ec94ea9e3631528"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "151",
       "sha": "bde8b1af68e6479a3a685a0ece372bb73c7ea093b7813ddb4dad6791f215b104"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "152-161",
       "sha": "e5bdecbdbf066ab14f91e4cecd4f06d5dbc20a1f55e62188bbe379783b4ce649"
      },
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "162-170",
       "sha": "bd53a17d000657d72fd722bed48c56093e9bd3c0047a74ddec5d449258de7df5"
      }
     ],
     "vs": "differs",
     "row": "4"
    }
   ],
