  {
   "key": "0xAB",
   "name": "Recording counter",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:MPU401-TRM.raw.txt",
     "lines": "1076"
    },
    {
     "ref": "dosbox-x:src/hardware/mpu401.cpp",
     "lines": "232-235"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The $AB command requests the RECORD COUNTER and then clears it.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1076",
       "sha": "e0935576031e0747595e26d81d2649486ae0c59eb1addb0ff975251ea5a546e8"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing $AB requests the RECORD COUNTER and then clears it.",
     "quotes": [
      {
       "ref": "datasheet:MPU401-TRM.raw.txt",
       "lines": "1076",
       "sha": "e0935576031e0747595e26d81d2649486ae0c59eb1addb0ff975251ea5a546e8"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "dosbox-x",
     "text": "The command answers the ACK and a zero instead of the counter.",
     "quotes": [
      {
       "ref": "dosbox-x:src/hardware/mpu401.cpp",
       "lines": "232-235",
       "sha": "e878eacb8bd3b79a61c1e06ffa7b052e664d9f18ca07780446f8acc14a77ab1a"
      }
     ],
     "vs": "differs",
