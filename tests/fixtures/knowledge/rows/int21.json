 "entries": [
  {
   "key": "0x21/0x3D",
   "name": "open file",
   "regions": [
    {
     "ref": "dosbox-x:src/dos/dos.cpp",
     "function": "DOS_21Handler",
     "case": [
      "0x3d"
     ]
    },
    {
     "ref": "dosbox-x:src/dos/dos.cpp",
     "function": "DOS_21Handler",
     "case": [
      "0x3d"
     ],
     "preamble": true
    },
    {
     "ref": "dosbox-x:src/dos/dos_files.cpp",
     "function": "DOS_OpenFile"
    },
    {
     "ref": "rbil61:INTERRUP.F",
     "lines": "6464-6580"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Open an existing file, a DOS 2 call (OPEN).",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6465",
       "sha": "459d9f4444901f8575822138ac9938d9221ac5d7ee34f0130797342b5d4c97fa"
      }
     ]
    },
    {
     "n": "2",
     "on": "in AL",
     "of": "doc",
     "text": "AL holds the access and sharing modes.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6467",
       "sha": "6eb7360cf8cdef8a9d9db422f535bf9d2c15e5bffc0655bc4d4996277b292412"
      }
     ]
    },
    {
     "n": "3",
     "on": "in DS:DX",
     "of": "doc",
     "text": "DS:DX points to an ASCIZ filename.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6468",
       "sha": "6f9aea944901663c2e1495c17e0c60b713df8a70c1269a33ead2916bec321a5d"
      }
     ]
    },
    {
     "n": "4",
     "on": "out CF=0",
     "of": "doc",
     "text": "On success CF is clear.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6470-6471",
       "sha": "b6933c4374329dd339e6e9ef2f3d3a975c2dd3c96b1f85f0b243ccba9a7c4f5b"
      }
     ]
    },
    {
     "n": "5",
     "on": "out AX",
     "of": "doc",
     "text": "On success AX holds the file handle.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6470-6471",
       "sha": "b6933c4374329dd339e6e9ef2f3d3a975c2dd3c96b1f85f0b243ccba9a7c4f5b"
      }
     ]
    },
    {
     "n": "6",
     "on": "out CF=1",
     "of": "doc",
     "text": "On error CF is set.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6472-6473",
       "sha": "6b447e8f074ca5649616639b975b5a7782d9346f6ff608debc7586dafed6e073"
      }
     ]
    },
    {
     "n": "7",
     "on": "out AX",
     "of": "doc",
     "text": "On error AX holds the DOS error code.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6472-6473",
       "sha": "6b447e8f074ca5649616639b975b5a7782d9346f6ff608debc7586dafed6e073"
      }
     ]
    },
    {
     "n": "8",
     "on": "does",
     "of": "doc",
     "text": "The file pointer is set to the start of the file.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6474",
       "sha": "8aee41fc1a75a8d5355cd51a841aedacb5d328fa3d18e6afc4aab6272002fa6e"
      }
     ]
    },
    {
     "n": "9",
     "on": "when",
     "of": "doc",
     "text": "If SHARE or a network is loaded the open may fail because the file is already open, by the sharing modes.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6475-6477",
       "sha": "195014699eb8ffac143fa485723880b78cca60785e4da971ee2a1cb4e48afd9f"
      }
     ]
    },
    {
     "n": "10",
     "on": "does",
     "of": "doc",
     "text": "Files with the hidden or system attribute may be opened.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6480",
       "sha": "c922d2fe3e6f799bb28f8447c25cd7df9f5dda67d6862f2ccb19732e0418498c"
      }
     ]
    },
    {
     "n": "11",
     "on": "when",
     "of": "doc",
     "text": "Sharing modes work on local drives only if SHARE is loaded.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6485",
       "sha": "5efeb2872dd75f5644d9473615171e1400b1906574ec0c1e6711cd3841ae9d85"
      }
     ]
    },
    {
     "n": "12",
     "on": "in AL",
     "of": "doc",
     "text": "Bits 2-0 select the access mode: 0 read only, 1 write only, 2 read/write.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6494-6497",
       "sha": "96d9aef58c977f34b3b711a8594f1b27b1e5e220ec4bb5465182264bc94c5693"
      }
     ]
    },
    {
     "n": "13",
     "on": "in AL",
     "of": "doc",
     "text": "From DOS 5, value 3 is internal: it is passed to the redirector on EXEC for case-sensitive names.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6498-6499",
       "sha": "d743955b1b776a779afbd7c2bdcc49f6e0bc21a1af2979e50b93bc730bb11bfd"
      }
     ]
    },
    {
     "n": "14",
     "on": "in AL",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "13",
     "text": "Value 3 of the access mode is refused by the local drive with error 0x0C access code invalid.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/drive_local.cpp",
       "lines": "1667-1669",
       "sha": "b8cccb119a56b8230e66c37eff317bdeed62173abd6ff0b06418c32a5818a14f"
      }
     ]
    },
    {
     "n": "15",
     "on": "in AL",
     "of": "doc",
     "text": "Bit 3 is reserved and zero.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6500",
       "sha": "8e141d804e3e8b6e8052b10fcdb631584869f056508218e326b280092e114626"
      }
     ]
    },
    {
     "n": "16",
     "on": "in AL",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "15",
     "text": "A set bit 3 reaches the local drive, which reads the low four bits as the access mode: 0x08 and up fail with 0x0C.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/drive_local.cpp",
       "lines": "1662",
       "sha": "206b12bc12d35577c479efe075273407921efdc80565c64260f4ae02700313dd"
      },
      {
       "ref": "dosbox-x:src/dos/drive_local.cpp",
       "lines": "1667-1669",
       "sha": "b8cccb119a56b8230e66c37eff317bdeed62173abd6ff0b06418c32a5818a14f"
      }
     ]
    },
    {
     "n": "17",
     "on": "in AL",
     "of": "doc",
     "text": "From DOS 3.0 bits 6-4 select the sharing mode: 0 compatibility, 1 deny all, 2 deny write, 3 deny read, 4 deny none.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6501-6506",
       "sha": "663ed3c752df82a368114151644e59c98fc95c20b549348b8c12da355d2f12e3"
      }
     ]
    },
    {
     "n": "18",
     "on": "in AL",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "17",
     "text": "The local drive keeps only the low four bits of AL as the access mode; bits 6 to 4 reach the host only with the share option on, under Windows.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/drive_local.cpp",
       "lines": "1662",
       "sha": "206b12bc12d35577c479efe075273407921efdc80565c64260f4ae02700313dd"
      },
      {
       "ref": "dosbox-x:src/dos/drive_local.cpp",
       "lines": "1693-1696",
       "sha": "2c1efd151de7a45585bc1490876ed1ea0dbb24ea7db7fb45711ad23bec8caf67"
      }
     ]
    },
    {
     "n": "19",
     "on": "in AL",
     "of": "doc",
     "text": "Sharing mode 7 is the network FCB, only during a server call.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6507",
       "sha": "f888bf8547d93eaf29e94ac302db3aacd27e8ebf69113ad50f3214c4f46f78c4"
      }
     ]
    },
    {
     "n": "20",
     "on": "in AL",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "19",
     "text": "The local drive reads sharing mode 7 like any other value of bits 6 to 4.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/drive_local.cpp",
       "lines": "1696",
       "sha": "72b78e22b1e88b8a22770f909c01732ae340c4f6744a088ab009e6e2dffb19fb"
      }
     ]
    },
    {
     "n": "21",
     "on": "in AL",
     "of": "doc",
     "text": "Bit 7 set makes the file private to the process and not inherited by children.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6508-6510",
       "sha": "2289eb4970a59117b4b256d9b9adf5b4400712e0ddb7de91a91dcd6c7c3d6771"
      }
     ]
    },
    {
     "n": "22",
     "on": "when",
     "of": "doc",
     "text": "In DOS 2 to 6.22 a second open succeeds, fails with 05h or raises INT 24, by the first and second sharing modes.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6514-6525",
       "sha": "e3e30cc973e4a7f6ba0e1745605024f4326064d3c6081f3205d60d77e9bc4f69"
      },
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6526-6537",
       "sha": "e70e9885392240e64157bdeeed5b308b1e85c290ee44421e84316bcdbe885afd"
      },
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6538-6538",
       "sha": "1de3c38f05645d9cb62703617ea4df438255428fb72f94acd8a6266f37fda7d6"
      },
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6539-6542",
       "sha": "37db2526bebb15ecd535f0bb280f18ce5e7937d4c42479c598fbab82fef54398"
      }
     ]
    },
    {
     "n": "23",
     "on": "when",
     "of": "doc",
     "text": "In DOS 7.x the sharing table adds an access that reads without updating the access time.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6546-6557",
       "sha": "075b4d7405f12f2ffc1a6bb2709d4862adfc21570e40b61e9ea00b26956d8c3f"
      },
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6558-6569",
       "sha": "278dcf356eb4fae5b4a70ce31b14a7d6f7767e95d260310bf422438819ce27f6"
      },
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6570-6575",
       "sha": "a30b0f137d833d82f43fad66371b366c8ad7574dd5456e49c1c2e4ecf0ba76b8"
      },
      {
       "ref": "rbil61:INTERRUP.F",
       "lines": "6576-6579",
       "sha": "84149e8b6d67d4ad3078e13cb4730049b5db93dd9febb51156af439decdd0913"
      }
     ]
    },
    {
     "n": "24",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "The INT 21h handler reaches it by its case 0x3d.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2014",
       "sha": "c3359b2ff4af9ba702ed647f22bec3656745f38a2ccfa8a2ae2c7f905600f8b8"
      }
     ]
    },
    {
     "n": "25",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A directory or volume-label name fails with 0x05 access denied.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1354-1358",
       "sha": "9ce2cfe4cfc690c1b54eb9ea4b8a7213edf1c4f5c3dbb335bd041e5c538986c3"
      }
     ]
    },
    {
     "n": "26",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "A failed open of a file that exists gives error 0x05 whenever the mode is not read only.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1421-1422",
       "sha": "d4839472927fd3be965ac64a24ed6f1c91af4cc84c11ec2a8420ce44e438394e"
      }
     ],
     "row": "9"
    },
    {
     "n": "27",
     "on": "when",
     "of": "dosbox-x",
     "vs": "differs",
     "text": "With the share option on, a failed open of an existing file on a local directory drive also gives 0x05.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1421",
       "sha": "cb0c95e9d4ea27da61acd81b76f4996f755b2f13ba0b27cb28936f4a542d738a"
      }
     ],
     "row": "11"
    },
    {
     "n": "28",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "On a DOS-V Japanese display, with the input-method flags set, $IBMAIAS and MS$KANJI return their own handles, as does $IBMAFNT; on a PC-98 so does AVSDRV$$.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2020-2028",
       "sha": "511cfbda6f728bacad22fb6daa7736257439a4b1e14e74a6e99016aadd9d3fa3"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2029-2031",
       "sha": "76c8a4ac2420c9d0e9141044f50fb9c9dea4b860e9abdc0e9b9b3c12eb283a9c"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2032-2043",
       "sha": "7aebe10417f00e24e132b295fd2d619eb3a31b7f0b4ce3654358865fb9ae80df"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2044-2055",
       "sha": "9ccd4156952e3da9dcb92cfcefb9df68ad41c46233f2d29ce0f91b20ab68ddd9"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2056-2065",
       "sha": "10cb2634efc74abe4547ff51c1a9029d10098a3ba6f68502ee10ce90645526ec"
      }
     ]
    },
    {
     "n": "29",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A name that is a device opens that device instead of a file.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1392-1396",
       "sha": "6c9cb3dc500b64ec08188d020ba246de47e94c3660abbbf54b60a6eed88f3b13"
      }
     ]
    },
    {
     "n": "30",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A free slot of the file table is searched for; a full table fails with 0x04.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1374-1383",
       "sha": "9f87432e02e188d3486aaf05283a7fb1bbb36591b80441b21560b0619c770a25"
      }
     ]
    },
    {
     "n": "31",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The handle comes from the process's own table, and a full one fails with 0x04.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1385-1389",
       "sha": "96b6c8e245f1de1893d91b2d8db7a8d157a3d2381cb45bed6a0597dfd08c484d"
      }
     ]
    },
    {
     "n": "32",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The error code is cleared before the drive opens the file and restored after; error 0x0C from the drive ends the open with that code.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1407-1408",
       "sha": "8da0d88f88bf286de716c5f27f383cad885519e9cc164f6e077bc30d30c64487"
      },
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1411-1412",
       "sha": "743b99286726ddaeba430eef5f9fe5fd4063d44efd810f75bd70406516d625e7"
      }
     ]
    },
    {
     "n": "33",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "A name that cannot be made into a full path fails with the error DOS_MakeName set.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1364",
       "sha": "cbb110618a60f61633caa66b13ba5df1e95a8324d493e6491e6475af4f5b63c0"
      }
     ]
    },
    {
     "n": "34",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "When that 0x05 test fails, the error is 0x03 if the path does not exist and 0x02 otherwise.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_files.cpp",
       "lines": "1424-1425",
       "sha": "283e58f980a89a67e75f91314c5e3eeaa8cde831f7b6f8a278e0e771ded7c398"
      }
     ]
    },
    {
     "n": "35",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "If the open fails and long names are on, it is tried again with the original mode.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2082",
       "sha": "30cdebdb0749caffacdf02076a35282ed36db0e69e354dbc1e1da3d9b16e3037"
      }
     ]
    },
    {
     "n": "36",
     "on": "when",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The call forces short names for the first try and ORs the disk delay flag into unmask_irq0.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2016",
       "sha": "2383382b1518d36460e58ce5f40cb61522db9b7c67be2aea1fcb147098761302"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2068",
       "sha": "03543ce8a03f976ec20d49c199f7aa553f8b5579351833e5590687454e539f2f"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2078",
       "sha": "dd89e9a18c3b07fb9fba0f7c34245feb9eaa212ad29374a99fb79e555d6c29bd"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2081",
       "sha": "dd89e9a18c3b07fb9fba0f7c34245feb9eaa212ad29374a99fb79e555d6c29bd"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2090",
       "sha": "dd89e9a18c3b07fb9fba0f7c34245feb9eaa212ad29374a99fb79e555d6c29bd"
      }
     ]
    },
    {
