   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Terminate with a return code, a DOS 2 call (EXIT).",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.G",
       "lines": "6163",
       "sha": "e933e1e63010a05b21e4f8ff0b2656f2e09081e60d27f805fc4c8c7e222bea85"
      }
     ]
    },
    {
     "n": "2",
     "on": "in AL",
     "of": "doc",
     "text": "AL holds the return code.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.G",
       "lines": "6165",
       "sha": "675a59cc66cc48ff88fbe9f31302643c65d8f60e49ca62b802df80cbb5286a6b"
      }
     ]
    },
    {
     "n": "3",
     "on": "out none",
     "of": "doc",
     "text": "The call never returns.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.G",
       "lines": "6166",
       "sha": "986614d1a40136956ffa49c08e9c138036c91115620d444c4cc2fd74c512b38b"
      }
     ]
    },
    {
     "n": "4",
     "on": "out none",
     "of": "dosbox-x",
     "vs": "differs",
     "row": "3",
     "text": "A process that is its own parent returns before closing anything; otherwise control goes to the parent's INT 22 address, and the handler sets AX to 0x3E01 and ends normally.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "118",
       "sha": "d49e57427c663d648185c61424df2337a021e7381191a312a251a8fb58a1bfe9"
      },
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "150-152",
       "sha": "e25379323ebfefed659d79a5332ae780eff09b6cec9abd521248e13c1e717123"
      },
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2507-2516",
       "sha": "573f0ad317244040efbeaaaae7d39137e8cf87f09ae636041d970c5ff1aa6f73"
      }
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "Unless the process is its own parent, all its open files are closed.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.G",
       "lines": "6167-6168",
       "sha": "0a8f5a0233336f97ee9a0103e4500494c0444d131b0434790de5db060c960e35"
      }
     ]
    },
    {
     "n": "6",
     "on": "does",
     "of": "doc",
     "text": "Unless the process is its own parent, all the memory belonging to it is freed.",
     "quotes": [
      {
       "ref": "rbil61:INTERRUP.G",
       "lines": "6168-6169",
       "sha": "457efd29425358204b0dfe98fa5c583bceac17ea7e78a86d41bd8e84cc695164"
      }
     ]
    },
    {
     "n": "7",
     "on": "place",
     "of": "dosbox-x",
     "vs": "place",
     "text": "The INT 21h handler reaches it by its case 0x4c.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos.cpp",
       "lines": "2495",
       "sha": "beec0f6e23cd676489c405eb2356b4d4c90131abc89a30e220a8af67ce8bf43f"
      }
     ]
    },
    {
     "n": "8",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The return code and the termination type, exit or TSR, are stored in the DOS state.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "114-115",
       "sha": "6da5c7febb1dafc5c306d63add21708f91f92da3f8fa7902bb04c539229639fc"
      }
     ]
    },
    {
     "n": "9",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The UTF-8 modes of the AMIS providers are told that the process ended.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "119-121",
       "sha": "29e40122b6f4859abcc84044c51abfa670d47da00c287bc64feafe8ebaba550a"
      }
     ]
    },
    {
     "n": "10",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The directory search snapshots of the process are closed with its files.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "125",
       "sha": "842461a088da7b98b7a40958e4460117e90059d40fef85fe9fbfd48d6155547d"
      }
     ]
    },
    {
     "n": "11",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The parent PSP becomes current and its saved registers and stack are restored, with INT 22's address as the return point.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "129-140",
       "sha": "5b24cba00c5708dc782debbf9f7e328cbe5e74de656e50c14c1c72e3e0477400"
      },
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "141-152",
       "sha": "a161f7fbd31aaab1981e47cb8601ac72c7958407529da87ea1038cfade34a02d"
      },
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "153-155",
       "sha": "e4aa032df14a81e46eadb03a3bb5828ac3ecab4c6c64cfdc51bfa19469b34592"
      }
     ]
    },
    {
     "n": "12",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "The process name is updated and the error code cleared.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "158",
       "sha": "b127427e153a6082254f46ba3048f70bc4418792643fff4fe6b07a31d1d9ffcc"
      },
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "160",
       "sha": "b88d9cce3e7540c539360cfac6afa3efee1e2ed97468e54db5d3d33e8c3e98fb"
      }
     ]
    },
    {
     "n": "13",
     "on": "does",
     "of": "dosbox-x",
     "vs": "extra",
     "text": "If the CPU core or cycles were set automatically by the program they are put back, and the title updated.",
     "quotes": [
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "162-173",
       "sha": "59e9fb3216014f10b7a018c2c39b065cb610158c8cdb96a5afa39339508b4a7b"
      },
      {
       "ref": "dosbox-x:src/dos/dos_execute.cpp",
       "lines": "174-175",
       "sha": "9ecd915b7d5572b14e5614a53cf164979b967b36dbac41ece0e42117dc7949f0"
      },
      {
