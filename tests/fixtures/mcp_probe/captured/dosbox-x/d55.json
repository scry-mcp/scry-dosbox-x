  "prompt": "Open a DOSBox-X session from /opt/dosfury/fury.conf, working directory /opt/dosfury, bounded to 600 seconds, nobody watching, with the emulator's CPU clock forced by the two command-line tokens -set and cpu cycles=fixed 2500, and with the guest's own int 3 instructions stopping it at the debugger.",
  "tool": "start",
  "args": {
   "conf": "/opt/dosfury/fury.conf",
   "cwd": "/opt/dosfury",
   "session_seconds": 600,
   "flags": [
    "-set",
    "cpu cycles=fixed 2500"
   ],
   "break_on_int3": true
  },
  "allow": [
   "shared"
  ],
  "grammar": [
   "-set"
  ]
 },
